<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Why act now — the climate math, plainly</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0D1B2A; --surface:#14273A; --card:#182F45;
    --ink:#EAF1F5; --ink-dim:#8FA6BA;
    --heat:#E8552A; --heat-dim:#7A331A;
    --cool:#3FA9C8; --cool-dim:#1F5266;
    --good:#5FB86A;
    --line:#23405A;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{background:var(--bg); color:var(--ink); font-family:'IBM Plex Sans', sans-serif; line-height:1.65;}
  h1,h2,h3{font-family:'Space Grotesk', sans-serif; font-weight:600; letter-spacing:-0.01em;}
  .mono{font-family:'IBM Plex Mono', monospace;}
  .wrap{max-width:1020px; margin:0 auto; padding:0 32px;}
  a{color:inherit;}

  nav{display:flex; justify-content:space-between; align-items:center; padding:26px 0; border-bottom:1px solid var(--line);}
  .logo{display:flex; align-items:center; gap:9px; font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:18px;}
  .logo .dot{width:9px; height:9px; border-radius:50%; background:var(--heat);}
  .navlinks{display:flex; gap:30px; font-size:14px; color:var(--ink-dim);}
  .navlinks a:hover{color:var(--ink);}
  .back{font-size:13px; color:var(--ink-dim); font-family:'IBM Plex Mono', monospace; text-decoration:none; background:none; border:none; cursor:pointer;}
  .back:hover{color:var(--ink);}

  .hero{padding:96px 0 72px; max-width:760px;}
  .eyebrow{font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--heat); margin-bottom:22px;}
  .hero h1{font-size:52px; line-height:1.1; margin-bottom:24px;}
  .hero p.lede{font-size:18px; color:var(--ink-dim); max-width:600px; margin-bottom:8px;}
  .source-note{font-size:12.5px; color:var(--ink-dim); margin-top:28px; font-family:'IBM Plex Mono', monospace;}

  .statrow{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); margin-top:44px;}
  .stat{background:var(--surface); padding:22px 20px;}
  .stat .num{font-family:'Space Grotesk', sans-serif; font-size:34px; font-weight:700; color:var(--heat);}
  .stat .label{font-size:13px; color:var(--ink-dim); margin-top:6px;}

  .section{padding:88px 0; border-top:1px solid var(--line);}
  .section-head{max-width:600px; margin-bottom:48px;}
  .section-head h2{font-size:32px; line-height:1.2;}
  .section-head p{color:var(--ink-dim); margin-top:14px; font-size:15px;}

  .ticker{display:flex; align-items:flex-end; gap:6px; height:220px; margin-bottom:8px; padding:0 0 24px; border-bottom:1px solid var(--line); position:relative;}
  .ticker .baseline{position:absolute; left:0; right:0; bottom:24px; border-top:1px dashed var(--ink-dim); opacity:0.35;}
  .tick{flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%;}
  .tick .bar{width:100%; max-width:52px; background:var(--cool-dim); border-radius:2px 2px 0 0; position:relative;}
  .tick.current .bar{background:var(--heat);}
  .tick .val{font-family:'IBM Plex Mono', monospace; font-size:11.5px; color:var(--ink-dim); margin-bottom:8px;}
  .tick.current .val{color:var(--heat); font-weight:500;}
  .tick .yr{font-family:'IBM Plex Mono', monospace; font-size:11.5px; color:var(--ink-dim); margin-top:10px;}
  .tick.current .yr{color:var(--ink);}
  .ticker-legend{display:flex; gap:24px; font-size:12.5px; color:var(--ink-dim); font-family:'IBM Plex Mono', monospace;}
  .ticker-legend span{display:flex; align-items:center; gap:6px;}
  .swatch{width:9px; height:9px; border-radius:2px;}

  .why-grid{display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--line); border:1px solid var(--line);}
  .why-card{background:var(--surface); padding:28px 26px;}
  .why-card .tag{font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.06em; text-transform:uppercase; color:var(--cool); margin-bottom:14px; display:block;}
  .why-card h3{font-size:18px; margin-bottom:10px;}
  .why-card p{font-size:14.5px; color:var(--ink-dim);}

  .actions{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
  .action{border:1px solid var(--line); padding:26px 22px; border-radius:2px;}
  .action .idx{font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--heat); margin-bottom:16px;}
  .action h3{font-size:17px; margin-bottom:10px;}
  .action p{font-size:14px; color:var(--ink-dim);}

  .final{text-align:center; padding:100px 0 96px;}
  .final h2{font-size:38px; max-width:600px; margin:0 auto 18px;}
  .final p{color:var(--ink-dim); margin-bottom:32px;}
  .btn{display:inline-flex; align-items:center; gap:8px; padding:13px 26px; border-radius:2px; font-size:15px; font-weight:500; text-decoration:none; font-family:'IBM Plex Mono', monospace; border:none; cursor:pointer;}
  .btn-primary{background:var(--heat); color:#1A0A05;}
  .btn-primary:hover{background:#F0663A;}
  .btn-ghost{background:transparent; border:1px solid var(--line); color:var(--ink);}
  .btn-ghost:hover{border-color:var(--ink-dim);}

  footer{border-top:1px solid var(--line); padding:30px 0; display:flex; justify-content:space-between; font-size:12.5px; color:var(--ink-dim); font-family:'IBM Plex Mono', monospace;}

  /* ---- game page ---- */
  .game-wrap{max-width:720px; margin:0 auto; padding:0 32px;}
  .game{padding:64px 0 96px;}
  .hud{display:flex; gap:1px; background:var(--line); border:1px solid var(--line); margin-bottom:44px;}
  .hud-item{flex:1; background:var(--surface); padding:16px 18px;}
  .hud-item .label{font-size:11px; color:var(--ink-dim); font-family:'IBM Plex Mono', monospace; text-transform:uppercase; letter-spacing:0.05em;}
  .hud-item .val{font-family:'Space Grotesk', sans-serif; font-size:22px; font-weight:600; margin-top:4px;}

  .scene{display:none;}
  .scene.active{display:block;}
  .scene h2{font-size:26px; line-height:1.3; margin-bottom:14px;}
  .scene p.body{color:var(--ink-dim); font-size:15px; margin-bottom:32px; max-width:560px;}

  .choice{display:block; width:100%; text-align:left; background:var(--surface); border:1px solid var(--line); border-radius:2px; padding:18px 20px; margin-bottom:12px; color:var(--ink); font-family:'IBM Plex Sans', sans-serif; font-size:15px; cursor:pointer;}
  .choice:hover{border-color:var(--cool); background:var(--card);}
  .choice .tag{display:block; font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--cool); margin-bottom:6px; text-transform:uppercase; letter-spacing:0.05em;}

  .end-stats{display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--line); border:1px solid var(--line); margin:32px 0;}
  .end-stat{background:var(--surface); padding:20px;}
  .end-stat .num{font-family:'Space Grotesk', sans-serif; font-size:30px; font-weight:700;}
  .end-stat .label{font-size:12.5px; color:var(--ink-dim); margin-top:4px;}

  /* ---- arcade page ---- */
  .arcade{padding:64px 0 96px; text-align:center;}
  .arcade-frame{position:relative; max-width:900px; margin:0 auto; border-radius:14px; padding:2px;
    background:linear-gradient(135deg, var(--cool), var(--good), var(--heat)); box-shadow:0 0 60px -10px rgba(63,169,200,0.45);}
  .arcade-inner{background:#061019; border-radius:12px; overflow:hidden; line-height:0;}
  #arcadeCanvas{width:100%; height:auto; display:block; touch-action:none; cursor:crosshair;}
  .arcade-hint{margin-top:22px; font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:var(--ink-dim);}
  .arcade-hint b{color:var(--cool);}

  /* ---- page toggling ---- */
  #page-game{display:none;}
  #page-arcade{display:none;}
  #page-quiz{display:none;}
  #page-ocean{display:none;}

  @media (max-width:820px){
    .hero h1{font-size:36px;}
    .statrow{grid-template-columns:1fr;}
    .why-grid{grid-template-columns:1fr;}
    .actions{grid-template-columns:1fr;}
    .navlinks{display:none;}
    .ticker{gap:3px;}
    .tick .yr, .tick .val{font-size:9.5px;}
  }
  @media (max-width:600px){
    .scene h2{font-size:21px;}
    .hud-item .val{font-size:18px;}
  }
</style>
</head>
<body>

<!-- ============ PAGE 1: main site ============ -->
<div id="page-main">

  <div class="wrap">
    <nav>
      <div class="logo"><span class="dot"></span>1.5°C</div>
      <div class="navlinks">
        <a href="#data">The data</a>
        <a href="#why-now">Why now</a>
        <a href="#act">What to do</a>
      </div>
    </nav>

    <section class="hero">
      <div class="eyebrow">The climate math, plainly</div>
      <h1>Every year we wait costs more than the year before it</h1>
      <p class="lede">Global temperatures are already about 1.3–1.5°C above pre-industrial levels. The last three years are the first on record to average above the 1.5°C mark scientists have long warned against crossing.</p>
      <p class="source-note">Sources: Copernicus/ECMWF, NOAA NCEI, Berkeley Earth (2025 reports)</p>

      <div class="statrow">
        <div class="stat">
          <div class="num">1.47°C</div>
          <div class="label">above pre-industrial levels, 2025 (Copernicus)</div>
        </div>
        <div class="stat">
          <div class="num">11</div>
          <div class="label">of the last 11 years are the warmest on record</div>
        </div>
        <div class="stat">
          <div class="num">~2030</div>
          <div class="label">when long-term warming may pass 1.5°C at current rates</div>
        </div>
      </div>
    </section>
  </div>

  <div class="section" id="data">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" style="color:var(--cool);">The data</div>
        <h2>A decade of records, not a single bad year</h2>
        <p>This isn't one hot summer. It's a decade-long climb, and the last three years have pushed past the threshold governments agreed to try to avoid.</p>
      </div>

      <div class="ticker">
        <div class="baseline"></div>
        <div class="tick"><span class="val">1.11</span><div class="bar" style="height:52%;"></div><span class="yr">2015</span></div>
        <div class="tick"><span class="val">1.25</span><div class="bar" style="height:60%;"></div><span class="yr">2016</span></div>
        <div class="tick"><span class="val">1.17</span><div class="bar" style="height:55%;"></div><span class="yr">2019</span></div>
        <div class="tick"><span class="val">1.29</span><div class="bar" style="height:63%;"></div><span class="yr">2023</span></div>
        <div class="tick current"><span class="val">1.60</span><div class="bar" style="height:82%;"></div><span class="yr">2024</span></div>
        <div class="tick current"><span class="val">1.47</span><div class="bar" style="height:74%;"></div><span class="yr">2025</span></div>
      </div>
      <div class="ticker-legend">
        <span><span class="swatch" style="background:var(--cool-dim);"></span>below 1.5°C</span>
        <span><span class="swatch" style="background:var(--heat);"></span>at or above 1.5°C</span>
      </div>
    </div>
  </div>

  <div class="section" id="why-now">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Why now, not later</div>
        <h2>Delay doesn't pause the problem. It compounds it.</h2>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <span class="tag">Physics, not opinion</span>
          <h3>Carbon dioxide accumulates</h3>
          <p>CO₂ released today stays in the atmosphere for centuries. Waiting doesn't just delay the fix — it adds to a total that has to be dealt with either way.</p>
        </div>
        <div class="why-card">
          <span class="tag">Tipping points</span>
          <h3>Some changes don't reverse easily</h3>
          <p>Ice sheet loss, coral die-off, and permafrost thaw can cross thresholds where the damage becomes effectively permanent on human timescales.</p>
        </div>
        <div class="why-card">
          <span class="tag">Cost curve</span>
          <h3>Adaptation gets more expensive later</h3>
          <p>Clean energy is now often cheaper than fossil alternatives in new installations. The window where the transition is also the cheap option is closing.</p>
        </div>
        <div class="why-card">
          <span class="tag">Every fraction counts</span>
          <h3>1.5°C isn't a cliff edge</h3>
          <p>There's no single line where things suddenly become fine or catastrophic. Each additional fraction of a degree adds measurably to the risk of extreme heat, drought, and flooding.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section" id="act">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" style="color:var(--cool);">What acting now looks like</div>
        <h2>Not everyone can do everything. Most people can do one thing well.</h2>
      </div>
      <div class="actions">
        <div class="action">
          <div class="idx">01 — at home</div>
          <h3>Cut the biggest sources first</h3>
          <p>Home heating/cooling and transport are usually the largest personal contributors. Efficiency upgrades and lower-carbon transport options tend to matter more than smaller daily swaps.</p>
        </div>
        <div class="action">
          <div class="idx">02 — with money</div>
          <h3>Follow where it's invested</h3>
          <p>Pensions, savings, and everyday spending all flow somewhere. Asking where is a low-effort way to add pressure at scale.</p>
        </div>
        <div class="action">
          <div class="idx">03 — with a voice</div>
          <h3>Local decisions add up</h3>
          <p>Zoning, transit, and building codes are often decided locally, and local turnout is usually low — a small group of engaged people can move real outcomes.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap final">
    <h2>The trend is clear. What happens next still isn't written.</h2>
    <p>See what five years of your own trade-offs might look like — clear the sky, or test what you know.</p>
    <button class="btn btn-primary" onclick="showPage('game')">Start your journey</button>
    <button class="btn btn-ghost" onclick="showPage('arcade')" style="margin-left:10px;">Play Air Clean-Up →</button>
    <button class="btn btn-ghost" onclick="showPage('quiz')" style="margin-left:10px;">Take the Pop Quiz →</button>
    <p style="margin-top:22px;"><a href="https://climate.copernicus.eu/copernicus-2025-was-third-hottest-year-record" style="font-size:13px; color:var(--ink-dim); font-family:'IBM Plex Mono', monospace;">Read the Copernicus 2025 report →</a></p>
  </div>

  <div class="wrap">
    <footer>
      <span>1.5°C — a plain accounting of the climate math</span>
      <span>Data: Copernicus / ECMWF, NOAA NCEI, Berkeley Earth</span>
    </footer>
  </div>

</div>

<!-- ============ PAGE 2: the game ============ -->
<div id="page-game">

  <nav class="wrap">
    <div class="logo"><span class="dot"></span>1.5°C</div>
    <button class="back" onclick="showPage('main')">← back to the data</button>
  </nav>

  <div class="game-wrap game">

    <div class="hud">
      <div class="hud-item">
        <div class="label">Year</div>
        <div class="val" id="hud-year">1 / 5</div>
      </div>
      <div class="hud-item">
        <div class="label">Carbon saved</div>
        <div class="val" id="hud-carbon">0 t</div>
      </div>
      <div class="hud-item">
        <div class="label">Budget spent</div>
        <div class="val" id="hud-money">$0</div>
      </div>
    </div>

    <div class="scene active" data-scene="0">
      <div class="eyebrow" style="color:var(--cool);">Your climate journey</div>
      <h2>Five years, one household, real trade-offs</h2>
      <p class="body">You're managing an average household's decisions over five years. Every choice trades off cost, convenience, and carbon. There's no perfect run — just better and worse ones.</p>
      <button class="choice" onclick="nextScene(1)"><span class="tag">Begin</span>Start year one</button>
    </div>

    <div class="scene" data-scene="1">
      <div class="eyebrow" style="color:var(--cool);">Year 1 — at home</div>
      <h2>Your heating system needs replacing</h2>
      <p class="body">The old gas furnace finally died in January. You need something new before winter.</p>
      <button class="choice" onclick="choose(0, -2000, 0)"><span class="tag">Lower cost</span>Install another gas furnace — cheapest option, keeps emissions the same</button>
      <button class="choice" onclick="choose(1.2, -5500, 3)"><span class="tag">Balanced</span>Install a heat pump — higher upfront cost, cuts heating emissions roughly in half</button>
      <button class="choice" onclick="choose(2.1, -9000, 3)"><span class="tag">Highest impact</span>Heat pump plus insulation upgrade — most expensive, biggest year-over-year cut</button>
    </div>

    <div class="scene" data-scene="2">
      <div class="eyebrow" style="color:var(--cool);">Year 2 — getting around</div>
      <h2>Your commute just got longer</h2>
      <p class="body">A new job means a 40-minute drive each way, five days a week.</p>
      <button class="choice" onclick="choose(0, 0, 0)"><span class="tag">No change</span>Keep driving your current car — no upfront cost, no change in emissions</button>
      <button class="choice" onclick="choose(0.9, -3200, 4)"><span class="tag">Balanced</span>Check if transit or carpooling covers most of the route</button>
      <button class="choice" onclick="choose(1.6, -14000, 3)"><span class="tag">Highest impact</span>Switch to an electric vehicle — largest cost, largest cut if your grid is reasonably clean</button>
    </div>

    <div class="scene" data-scene="3">
      <div class="eyebrow" style="color:var(--cool);">Year 3 — with your money</div>
      <h2>Your pension provider sends its annual update</h2>
      <p class="body">You get a letter explaining where your retirement savings are currently invested.</p>
      <button class="choice" onclick="choose(0, 0, 0)"><span class="tag">Skip it</span>File the letter away — takes no time, changes nothing</button>
      <button class="choice" onclick="choose(0.4, 0, 5)"><span class="tag">Balanced</span>Ask your provider what a lower-carbon fund option would look like</button>
      <button class="choice" onclick="choose(0.7, -50, 5)"><span class="tag">Highest impact</span>Switch your default fund to their lower-carbon option — small fee, no lifestyle change</button>
    </div>

    <div class="scene" data-scene="4">
      <div class="eyebrow" style="color:var(--cool);">Year 4 — locally</div>
      <h2>There's a city council vote on bike lanes and bus frequency</h2>
      <p class="body">Turnout for local elections in your area is usually under 20%.</p>
      <button class="choice" onclick="choose(0, 0, 0)"><span class="tag">Sit it out</span>Skip the vote — it's a small local race, doesn't seem worth it</button>
      <button class="choice" onclick="choose(0.3, 0, 4)"><span class="tag">Balanced</span>Vote, but don't look much further into it</button>
      <button class="choice" onclick="choose(0.5, 0, 4)"><span class="tag">Highest impact</span>Vote and show up to the public comment session — takes an evening</button>
    </div>

    <div class="scene" data-scene="5">
      <div class="eyebrow" style="color:var(--cool);">Year 5 — day to day</div>
      <h2>You're rethinking your weekly grocery routine</h2>
      <p class="body">Red meat and dairy tend to carry a larger footprint per meal than most alternatives.</p>
      <button class="choice" onclick="choose(0, 0, 0)"><span class="tag">No change</span>Keep your routine as it is</button>
      <button class="choice" onclick="choose(0.6, -200, 2)"><span class="tag">Balanced</span>Swap a couple of meals a week for lower-footprint options</button>
      <button class="choice" onclick="choose(1.1, -400, 2)"><span class="tag">Highest impact</span>Cut red meat to occasional — biggest shift, takes more adjusting</button>
    </div>

    <div class="scene" data-scene="end">
      <div class="eyebrow" style="color:var(--cool);">Five years later</div>
      <h2 id="end-headline">Here's where you landed</h2>
      <p class="body" id="end-body"></p>
      <div class="end-stats">
        <div class="end-stat">
          <div class="num" id="end-carbon">0 t</div>
          <div class="label">Estimated CO₂ saved per year, vs. no changes</div>
        </div>
        <div class="end-stat">
          <div class="num" id="end-money">$0</div>
          <div class="label">Total spent across five years</div>
        </div>
      </div>
      <button class="btn btn-ghost" onclick="restartGame()" style="margin-right:10px;">Play again</button>
      <button class="btn btn-primary" onclick="showPage('arcade')" style="margin-right:10px;">Play Air Clean-Up →</button>
      <button class="btn btn-ghost" onclick="showPage('main')">Back to the data</button>
    </div>

  </div>

  <div class="wrap">
    <footer>
      <span>Illustrative estimates for a typical household — not a personal carbon calculator.</span>
    </footer>
  </div>

</div>

<!-- ============ PAGE 3: Air Clean-Up arcade ============ -->
<div id="page-arcade">

  <nav class="wrap">
    <div class="logo"><span class="dot"></span>1.5°C</div>
    <button class="back" onclick="showPage('main')">← back to the data</button>
  </nav>

  <div class="wrap arcade">
    <div class="eyebrow" style="color:var(--cool);">Mini game</div>
    <h2 style="font-size:28px; margin-bottom:8px;">Air Clean-Up</h2>
    <p style="color:var(--ink-dim); font-size:14.5px; margin-bottom:28px;">Sweep the smog, dust and fumes before the air quality index maxes out.</p>

    <div class="arcade-frame">
      <div class="arcade-inner">
        <canvas id="arcadeCanvas" width="900" height="560"></canvas>
      </div>
    </div>
    <p class="arcade-hint"><b>←/→ or A/D</b> to move · <b>SPACE / click</b> to clean · mouse & touch also steer · <b>ENTER</b> to start</p>
  </div>

  <div class="wrap">
    <footer>
      <span>A quick arcade break — not a model of real air quality response.</span>
    </footer>
  </div>

</div>

<!-- ============ PAGE 4: Pop Quiz ============ -->
<div id="page-quiz">

  <nav class="wrap">
    <div class="logo"><span class="dot"></span>1.5°C</div>
    <button class="back" onclick="showPage('main')">← back to the data</button>
  </nav>

  <div class="game-wrap game">

    <div class="hud">
      <div class="hud-item">
        <div class="label">Question</div>
        <div class="val" id="quiz-hud-q">1 / 5</div>
      </div>
      <div class="hud-item">
        <div class="label">Correct</div>
        <div class="val" id="quiz-hud-score">0</div>
      </div>
    </div>

    <div class="scene active" data-quiz-scene="0">
