<script>
  // ---- page toggling ----
  function showPage(id){
    document.getElementById('page-main').style.display = (id === 'main') ? 'block' : 'none';
    document.getElementById('page-game').style.display = (id === 'game') ? 'block' : 'none';
    document.getElementById('page-arcade').style.display = (id === 'arcade') ? 'block' : 'none';
    document.getElementById('page-quiz').style.display = (id === 'quiz') ? 'block' : 'none';
    document.getElementById('page-ocean').style.display = (id === 'ocean') ? 'block' : 'none';
    window.scrollTo(0,0);
  }

  // ---- game logic ----
  let carbon = 0;
  let money = 0;
  const order = [1,2,3,4,5];
  let step = 0;

  function updateHud(){
    document.getElementById('hud-year').textContent = Math.min(step+1,5) + ' / 5';
    document.getElementById('hud-carbon').textContent = Math.round(carbon*10)/10 + ' t';
    document.getElementById('hud-money').textContent = '$' + Math.abs(money).toLocaleString();
  }

  function showScene(id){
    document.querySelectorAll('#page-game .scene').forEach(s => s.classList.remove('active'));
    document.querySelector('#page-game [data-scene="'+id+'"]').classList.add('active');
  }

  function nextScene(id){
    showScene(id);
  }

  function choose(carbonDelta, moneyDelta, impactLevel){
    carbon += carbonDelta;
    money += moneyDelta;
    step++;
    updateHud();
    if(step >= order.length){
      finishGame();
    } else {
      showScene(order[step]);
    }
  }

  function finishGame(){
    let headline, body;
    if(carbon >= 5){
      headline = "A meaningfully lower footprint";
      body = "You leaned into the higher-impact choice most years. It cost more upfront, but the estimated yearly savings are substantial.";
    } else if(carbon >= 2){
      headline = "A balanced five years";
      body = "You mixed convenience with impact — a realistic pace for most households, with real savings adding up over time.";
    } else {
      headline = "Mostly steady as it was";
      body = "You kept costs and disruption low. That's a valid choice too — though the estimated carbon savings stayed close to zero.";
    }
    document.getElementById('end-headline').textContent = headline;
    document.getElementById('end-body').textContent = body;
    document.getElementById('end-carbon').textContent = (Math.round(carbon*10)/10) + ' t';
    document.getElementById('end-money').textContent = '$' + Math.abs(money).toLocaleString();
    showScene('end');
  }

  function restartGame(){
    carbon = 0; money = 0; step = 0;
    updateHud();
    showScene(0);
  }

  updateHud();
</script>

<script>
// ===================== POP QUIZ =====================
let quizStep = 0, quizScore = 0;
const quizOrder = [1,2,3,4,5];

function showQuizScene(id){
  document.querySelectorAll('#page-quiz .scene').forEach(s => s.classList.remove('active'));
  document.querySelector('#page-quiz [data-quiz-scene="'+id+'"]').classList.add('active');
}

function updateQuizHud(){
  document.getElementById('quiz-hud-q').textContent = Math.min(quizStep+1,5) + ' / 5';
  document.getElementById('quiz-hud-score').textContent = quizScore;
}

function quizNext(id){
  showQuizScene(id);
}

function quizAnswer(correct){
  if(correct) quizScore++;
  quizStep++;
  updateQuizHud();
  if(quizStep >= quizOrder.length){
    finishQuiz();
  } else {
    showQuizScene(quizOrder[quizStep]);
  }
}

function finishQuiz(){
  let headline, body;
  if(quizScore === 5){
    headline = "Perfect score";
    body = "You caught every one — the side quest is calling.";
  } else if(quizScore >= 3){
    headline = "Solid grasp of the numbers";
    body = "You picked up most of it. Worth a skim back through the data section when you have a minute.";
  } else {
    headline = "Room to review";
    body = "A few slipped by — the data section above covers all five, if you want another pass.";
  }
  document.getElementById('quiz-end-headline').textContent = headline;
  document.getElementById('quiz-end-body').textContent = body;
  document.getElementById('quiz-end-score').textContent = quizScore + ' / 5';
  showQuizScene('end');
}

function restartQuiz(){
  quizStep = 0; quizScore = 0;
  updateQuizHud();
  showQuizScene(0);
}

updateQuizHud();
</script>

<script>
// ===================== AIR CLEAN-UP (arcade) =====================
(function(){
  const cv = document.getElementById('arcadeCanvas');
  const ctx = cv.getContext('2d');
  const W = 900, H = 560;

  // pull the site's palette straight from CSS vars so the game glows in-brand
  const css = getComputedStyle(document.documentElement);
  const COOL = css.getPropertyValue('--cool').trim() || '#3FA9C8';
  const HEAT = css.getPropertyValue('--heat').trim() || '#E8552A';
  const GOOD = css.getPropertyValue('--good').trim() || '#5FB86A';
  const INK  = css.getPropertyValue('--ink').trim()  || '#EAF1F5';

  const GRIME = {
    dust:  {r:12, sp:60,  pts:10, dmg:3,  col:'#c9b79a', name:'Dust'},
    fume:  {r:15, sp:130, pts:20, dmg:5,  col:'#9aa7b4', name:'Fume'},
    smog:  {r:24, sp:50,  pts:35, dmg:8,  col:'#6b7684', name:'Smog Blob'},
    stack: {r:28, sp:40,  pts:55, dmg:10, col:'#3b4552', name:'Smoke Puff'}
  };

  let state='menu', score=0, best=0, wave=0, aqi=0, combo=0, shake=0, time=0;
  let player, beams, grime, drops, parts, queue, banner;
  const keys={}; let ptr={x:W/2, active:false, down:false};

  function mult(){ return 1 + Math.min(3, Math.floor(combo/6)); }

  function reset(){
    score=0; wave=0; aqi=0; combo=0; shake=0;
    player = {x:W/2, y:H-52, sp:420, cool:0, boost:0, inv:0};
    beams=[]; grime=[]; drops=[]; parts=[]; queue=[];
    banner = {txt:'', t:0};
    nextWave();
  }

  function nextWave(){
    wave++;
    banner = {txt:'WAVE '+wave, t:1.4};
    const pool=['dust'];
    if(wave>=2) pool.push('fume');
    if(wave>=3) pool.push('smog');
    if(wave>=5) pool.push('stack');
    const n = 6 + wave*2, gap = Math.max(0.3, 0.9 - wave*0.045);
    for(let i=0;i<n;i++)
      queue.push({type:pool[Math.random()*pool.length|0], t: i===0?1:gap*(0.6+Math.random()*0.8)});
  }

  function spawn(type){
    const d = GRIME[type];
    grime.push({type, x:40+Math.random()*(W-80), y:-40, r:d.r, t:Math.random()*6,
      vx:(Math.random()<0.5?-1:1)*d.sp});
  }

  function burst(x,y,col,n){
    for(let i=0;i<n;i++){
      const a=Math.random()*6.283, s=40+Math.random()*180;
      parts.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:0.45+Math.random()*0.4,col,r:1+Math.random()*3});
    }
  }

  function fire(){
    const y=player.y-18;
    if(player.boost>0){
      beams.push({x:player.x,y,vx:0,vy:-620});
      beams.push({x:player.x-12,y:y+6,vx:-130,vy:-600});
      beams.push({x:player.x+12,y:y+6,vx:130,vy:-600});
    } else beams.push({x:player.x,y,vx:0,vy:-620});
    player.cool = player.boost>0 ? 0.10 : 0.15;
  }

  function hurt(n){
    aqi=Math.min(100,aqi+n); combo=0; shake=Math.max(shake,8);
    if(aqi>=100){ state='over'; best=Math.max(best,score); }
  }

  function kill(g){
    const d=GRIME[g.type];
    score += d.pts*mult(); combo++;
    burst(g.x,g.y,d.col,14);
    if(g.type==='smog') for(let i=0;i<2;i++)
      grime.push({type:'dust', x:g.x+(i?16:-16), y:g.y, r:12, t:Math.random()*6, vx:0});
    if(Math.random()<0.1) drops.push({x:g.x, y:g.y, kind: Math.random()<0.5?'boost':'clean', t:0});
  }

  function update(dt){
    time+=dt;
    if(shake>0) shake=Math.max(0,shake-dt*30);
    if(banner.t>0) banner.t-=dt;

    let dir=0;
    if(keys.ArrowLeft||keys.a) dir--;
    if(keys.ArrowRight||keys.d) dir++;
    if(dir) player.x += dir*player.sp*dt;
    else if(ptr.active) player.x += (ptr.x-player.x)*Math.min(1,dt*14);
    player.x = Math.max(28, Math.min(W-28, player.x));
    player.cool -= dt;
    if(player.boost>0) player.boost -= dt;
    if(player.inv>0) player.inv -= dt;
    if((keys[' ']||ptr.down) && player.cool<=0) fire();

    if(queue.length){
      queue[0].t -= dt;
      if(queue[0].t<=0) spawn(queue.shift().type);
    } else if(!grime.length) nextWave();

    for(let i=beams.length-1;i>=0;i--){
      const b=beams[i]; b.x+=b.vx*dt; b.y+=b.vy*dt;
      if(b.y<-20) beams.splice(i,1);
    }

    for(let i=grime.length-1;i>=0;i--){
      const g=grime[i], d=GRIME[g.type];
      g.t+=dt;
      if(g.type==='dust'){ g.y+=d.sp*dt; g.x+=Math.sin(g.t*1.5)*36*dt; }
      else if(g.type==='fume'){ g.y+=d.sp*dt; g.x+=Math.sign(player.x-g.x)*50*dt; }
      else if(g.type==='smog'){ g.y+=d.sp*dt; g.x+=g.vx*0.5*dt; if(g.x<g.r||g.x>W-g.r) g.vx*=-1; }
      else if(g.type==='stack'){ g.y+=d.sp*dt; g.x+=Math.sin(g.t*2)*30*dt; }

      for(let j=beams.length-1;j>=0;j--){
        const b=beams[j];
        if((b.x-g.x)**2+(b.y-g.y)**2 < g.r*g.r){
          beams.splice(j,1); burst(b.x,b.y,COOL,4);
          kill(g); grime.splice(i,1); break;
        }
      }
      if(i>=grime.length) continue;
      const gg = grime[i]; if(!gg) continue;
      if(gg.y-gg.r>H){ grime.splice(i,1); hurt(d.dmg); continue; }
      if(player.inv<=0 && Math.abs(gg.x-player.x)<gg.r+24 && Math.abs(gg.y-player.y)<gg.r+16){
        grime.splice(i,1); hurt(d.dmg+3); player.inv=1; burst(gg.x,gg.y,d.col,10);
      }
    }

    for(let i=drops.length-1;i>=0;i--){
      const p=drops[i]; p.y+=90*dt; p.t+=dt;
      if(p.y>H+20){ drops.splice(i,1); continue; }
      if(Math.abs(p.x-player.x)<32 && Math.abs(p.y-player.y)<24){
        if(p.kind==='boost'){ player.boost=10; banner={txt:'TRIPLE BEAM',t:1.1}; }
        if(p.kind==='clean'){ aqi=Math.max(0,aqi-20); banner={txt:'AIR FILTER — AQI −20',t:1.1}; }
        drops.splice(i,1);
      }
    }

    for(let i=parts.length-1;i>=0;i--){
      const p=parts[i]; p.x+=p.vx*dt; p.y+=p.vy*dt; p.vy+=120*dt; p.life-=dt;
      if(p.life<=0) parts.splice(i,1);
    }
  }

  function glowCircle(x,y,r,col,blur){
    ctx.save();
    ctx.shadowColor=col; ctx.shadowBlur=blur;
    ctx.fillStyle=col;
    ctx.beginPath(); ctx.arc(x,y,r,0,6.283); ctx.fill();
    ctx.restore();
  }

  function draw(){
    ctx.save();
    if(shake>0) ctx.translate((Math.random()-0.5)*shake,(Math.random()-0.5)*shake);

    const f=aqi/100, g=ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0, `rgb(${13+90*f},${27+40*f},${42-10*f})`);
    g.addColorStop(1, `rgb(${20+60*f},${39+40*f},${58-10*f})`);
    ctx.fillStyle=g; ctx.fillRect(0,0,W,H);

    // soft glowing haze streaks
    for(let i=0;i<4;i++){
      const x=(i*260+time*10)%(W+300)-150;
      ctx.save(); ctx.globalAlpha=0.06; ctx.shadowColor=COOL; ctx.shadowBlur=40;
      ctx.fillStyle=COOL;
      ctx.beginPath(); ctx.ellipse(x,80+i*46,120,28,0,0,6.283); ctx.fill();
      ctx.restore();
    }

    parts.forEach(p=>{ ctx.globalAlpha=Math.max(0,p.life); glowCircle(p.x,p.y,p.r,p.col,10); });
    ctx.globalAlpha=1;

    grime.forEach(gr=>{
      const d=GRIME[gr.type];
      glowCircle(gr.x,gr.y,gr.r,d.col,16);
    });

    beams.forEach(b=>glowCircle(b.x,b.y,4,COOL,18));

    drops.forEach(p=>{
      const col = p.kind==='boost'?GOOD:COOL;
      ctx.save(); ctx.shadowColor=col; ctx.shadowBlur=22; ctx.fillStyle=col;
      ctx.beginPath(); ctx.roundRect(p.x-13,p.y-13,26,26,7); ctx.fill(); ctx.restore();
    });

    // player: glowing purifier
    if(!(player.inv>0 && Math.floor(time*16)%2)){
      ctx.save(); ctx.translate(player.x,player.y);
      ctx.shadowColor=player.boost>0?GOOD:COOL; ctx.shadowBlur=26;
      ctx.fillStyle='#dfe9f0';
      ctx.beginPath(); ctx.roundRect(-28,-14,56,28,9); ctx.fill();
      ctx.fillStyle=player.boost>0?GOOD:COOL;
      ctx.beginPath(); ctx.roundRect(-14,-22,28,12,5); ctx.fill();
      ctx.shadowBlur=0;
      ctx.restore();
    }
    ctx.restore();

    // HUD with text glow
    ctx.textAlign='left';
    ctx.shadowColor=HEAT; ctx.shadowBlur=10;
    ctx.fillStyle=INK; ctx.font='bold 22px Space Grotesk, system-ui';
    ctx.fillText('SCORE '+score, 18, 32);
    ctx.shadowBlur=0;
    ctx.font='13px IBM Plex Mono, monospace'; ctx.fillStyle='rgba(234,241,245,.7)';
    ctx.fillText('BEST '+best, 18, 52);
    if(mult()>1){
      ctx.shadowColor=GOOD; ctx.shadowBlur=10;
      ctx.fillStyle=GOOD; ctx.font='bold 15px IBM Plex Mono, monospace';
      ctx.fillText('COMBO ×'+mult(), 18, 74); ctx.shadowBlur=0;
    }

    ctx.textAlign='right'; ctx.shadowColor=COOL; ctx.shadowBlur=10;
    ctx.fillStyle=INK; ctx.font='bold 18px Space Grotesk, system-ui';
    ctx.fillText('WAVE '+wave, W-18, 32); ctx.shadowBlur=0;

    const bw=280, bx=W/2-bw/2;
    ctx.fillStyle='rgba(0,0,0,.4)'; ctx.beginPath(); ctx.roundRect(bx,14,bw,16,8); ctx.fill();
    const barCol = aqi<40?GOOD:aqi<75?'#facc15':HEAT;
    ctx.save(); ctx.shadowColor=barCol; ctx.shadowBlur=14; ctx.fillStyle=barCol;
    ctx.beginPath(); ctx.roundRect(bx,14,bw*(aqi/100),16,8); ctx.fill(); ctx.restore();
    ctx.fillStyle='#fff'; ctx.font='bold 11px IBM Plex Mono, monospace'; ctx.textAlign='center';
    ctx.fillText('AQI '+Math.round(aqi)+' / 100', W/2, 26);

    if(banner.t>0){
      ctx.globalAlpha=Math.min(1,banner.t);
      ctx.textAlign='center'; ctx.shadowColor=COOL; ctx.shadowBlur=20;
      ctx.fillStyle='#fff'; ctx.font='bold 32px Space Grotesk, system-ui';
      ctx.fillText(banner.txt, W/2, H/2-40);
      ctx.shadowBlur=0; ctx.globalAlpha=1;
    }
  }

  function overlay(title,lines){
    ctx.fillStyle='rgba(6,16,25,.84)'; ctx.fillRect(0,0,W,H);
    ctx.textAlign='center';
    ctx.shadowColor=COOL; ctx.shadowBlur=30;
    ctx.fillStyle=COOL; ctx.font='bold 46px Space Grotesk, system-ui';
    ctx.fillText(title, W/2, H/2-70);
    ctx.shadowBlur=0;
    ctx.fillStyle=INK; ctx.font='15px IBM Plex Sans, system-ui';
    lines.forEach((l,i)=>ctx.fillText(l, W/2, H/2-18+i*26));
  }

  let last=performance.now();
  function loop(now){
    const dt=Math.min(0.033,(now-last)/1000); last=now;
    if(state==='play'){ update(dt); draw(); }
    else if(state==='menu'){
      ctx.fillStyle='#061019'; ctx.fillRect(0,0,W,H);
      overlay('AIR CLEAN-UP', [
        'Clear the grime before the AQI meter fills up.',
        '',
        'ARROWS / A-D to move  ·  SPACE or click to clean  ·  mouse/touch to steer',
        'Dust · Fumes · Smog (splits!) · Smoke Puffs — waves get busier over time',
        'Green pickup = triple beam   Cyan pickup = AQI −20',
        '',
        'Press ENTER or click to start'
      ]);
    } else {
      draw();
      overlay('AIR QUALITY MAXED OUT', [
        'Final score: '+score+'   ·   Best: '+best,
        'You made it to wave '+wave,
        '', 'Press ENTER or click to try again'
      ]);
    }
    requestAnimationFrame(loop);
  }

  function start(){ if(state!=='play'){ reset(); state='play'; } }

  window.addEventListener('keydown', e=>{
    keys[e.key]=true;
    if(e.key===' '||e.key.startsWith('Arrow')) e.preventDefault();
    if(e.key==='Enter') start();
  });
  window.addEventListener('keyup', e=>keys[e.key]=false);

  function px(e){ const r=cv.getBoundingClientRect(); return (e.clientX-r.left)*(W/r.width); }
  cv.addEventListener('pointerdown', e=>{ ptr.down=true; ptr.active=true; ptr.x=px(e); start(); });
  window.addEventListener('pointerup', ()=>ptr.down=false);
  cv.addEventListener('pointermove', e=>{ ptr.active=true; ptr.x=px(e); });

  requestAnimationFrame(loop);
})();
</script>

<script>
// ===================== OCEAN CLEAN-UP (side quest) =====================
(function(){
  const cv = document.getElementById('oceanCanvas');
  const ctx = cv.getContext('2d');
  const W = 900, H = 560;
  const MAX_WAVE = 3;

  const css = getComputedStyle(document.documentElement);
  const COOL = css.getPropertyValue('--cool').trim() || '#3FA9C8';
  const HEAT = css.getPropertyValue('--heat').trim() || '#E8552A';
  const GOOD = css.getPropertyValue('--good').trim() || '#5FB86A';
  const INK  = css.getPropertyValue('--ink').trim()  || '#EAF1F5';

  const TRASH = {
    bottle: {r:12, sp:55, pts:10, dmg:4,  col:'#8fd7ff', name:'Bottle'},
    bag:    {r:18, sp:70, pts:20, dmg:6,  col:'#e2e8f0', name:'Bag'},
    net:    {r:26, sp:45, pts:40, dmg:9,  col:'#334155', name:'Net'}
  };

  let state='menu', score=0, best=0, wave=0, pollution=0, combo=0, shake=0, time=0;
  let player, beams, trash, drops, parts, queue, banner;
  const keys={}; let ptr={x:W/2, active:false, down:false};

  function mult(){ return 1 + Math.min(3, Math.floor(combo/6)); }

  function reset(){
    score=0; wave=0; pollution=0; combo=0; shake=0;
    player = {x:W/2, y:H-52, sp:420, cool:0, boost:0, inv:0};
    beams=[]; trash=[]; drops=[]; parts=[]; queue=[];
    banner = {txt:'', t:0};
    nextWave();
  }

  function nextWave(){
    wave++;
    banner = {txt:'WAVE '+wave+' OF '+MAX_WAVE, t:1.4};
    const pool=['bottle'];
    if(wave>=2) pool.push('bag');
    if(wave>=3) pool.push('net');
    const n = 6 + wave*2, gap = Math.max(0.32, 0.9 - wave*0.05);
    for(let i=0;i<n;i++)
      queue.push({type:pool[Math.random()*pool.length|0], t: i===0?1:gap*(0.6+Math.random()*0.8)});
  }

  function spawn(type){
    const d = TRASH[type];
    trash.push({type, x:40+Math.random()*(W-80), y:-40, r:d.r, t:Math.random()*6,
      vx:(Math.random()<0.5?-1:1)*d.sp});
  }

  function burst(x,y,col,n){
    for(let i=0;i<n;i++){
      const a=Math.random()*6.283, s=40+Math.random()*180;
      parts.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:0.45+Math.random()*0.4,col,r:1+Math.random()*3});
    }
  }

  function fire(){
    const y=player.y-18;
    if(player.boost>0){
      beams.push({x:player.x,y,vx:0,vy:-620});
      beams.push({x:player.x-12,y:y+6,vx:-130,vy:-600});
      beams.push({x:player.x+12,y:y+6,vx:130,vy:-600});
    } else beams.push({x:player.x,y,vx:0,vy:-620});
    player.cool = player.boost>0 ? 0.10 : 0.15;
  }

  function hurt(n){
    pollution=Math.min(100,pollution+n); combo=0; shake=Math.max(shake,8);
    if(pollution>=100){ state='over'; best=Math.max(best,score); }
  }

  function kill(g){
    const d=TRASH[g.type];
    score += d.pts*mult(); combo++;
    burst(g.x,g.y,d.col,14);
    if(g.type==='bag') for(let i=0;i<2;i++)
      trash.push({type:'bottle', x:g.x+(i?16:-16), y:g.y, r:12, t:Math.random()*6, vx:0});
    if(Math.random()<0.1) drops.push({x:g.x, y:g.y, kind: Math.random()<0.5?'boost':'clean', t:0});
  }

  function update(dt){
    time+=dt;
    if(shake>0) shake=Math.max(0,shake-dt*30);
    if(banner.t>0) banner.t-=dt;

    let dir=0;
    if(keys.ArrowLeft||keys.a) dir--;
    if(keys.ArrowRight||keys.d) dir++;
    if(dir) player.x += dir*player.sp*dt;
    else if(ptr.active) player.x += (ptr.x-player.x)*Math.min(1,dt*14);
    player.x = Math.max(28, Math.min(W-28, player.x));
    player.cool -= dt;
    if(player.boost>0) player.boost -= dt;
    if(player.inv>0) player.inv -= dt;
    if((keys[' ']||ptr.down) && player.cool<=0) fire();

    if(queue.length){
      queue[0].t -= dt;
      if(queue[0].t<=0) spawn(queue.shift().type);
    } else if(!trash.length){
      if(wave>=MAX_WAVE){ state='win'; best=Math.max(best,score); }
      else nextWave();
    }

    for(let i=beams.length-1;i>=0;i--){
      const b=beams[i]; b.x+=b.vx*dt; b.y+=b.vy*dt;
      if(b.y<-20) beams.splice(i,1);
    }

    for(let i=trash.length-1;i>=0;i--){
      const g=trash[i], d=TRASH[g.type];
      g.t+=dt;
      if(g.type==='bottle'){ g.y+=d.sp*dt; g.x+=Math.sin(g.t*1.5)*36*dt; }
      else if(g.type==='bag'){ g.y+=d.sp*dt; g.x+=Math.sin(g.t*2.2)*60*dt; }
      else if(g.type==='net'){ g.y+=d.sp*dt; g.x+=g.vx*0.5*dt; if(g.x<g.r||g.x>W-g.r) g.vx*=-1; }

      for(let j=beams.length-1;j>=0;j--){
        const b=beams[j];
        if((b.x-g.x)**2+(b.y-g.y)**2 < g.r*g.r){
          beams.splice(j,1); burst(b.x,b.y,COOL,4);
          kill(g); trash.splice(i,1); break;
        }
      }
      if(i>=trash.length) continue;
      const gg = trash[i]; if(!gg) continue;
      if(gg.y-gg.r>H){ trash.splice(i,1); hurt(d.dmg); continue; }
      if(player.inv<=0 && Math.abs(gg.x-player.x)<gg.r+24 && Math.abs(gg.y-player.y)<gg.r+16){
        trash.splice(i,1); hurt(d.dmg+3); player.inv=1; burst(gg.x,gg.y,d.col,10);
      }
    }

    for(let i=drops.length-1;i>=0;i--){
      const p=drops[i]; p.y+=90*dt; p.t+=dt;
      if(p.y>H+20){ drops.splice(i,1); continue; }
      if(Math.abs(p.x-player.x)<32 && Math.abs(p.y-player.y)<24){
        if(p.kind==='boost'){ player.boost=10; banner={txt:'TRIPLE NET',t:1.1}; }
        if(p.kind==='clean'){ pollution=Math.max(0,pollution-20); banner={txt:'OCEAN FILTER — POLLUTION −20',t:1.1}; }
        drops.splice(i,1);
      }
    }

    for(let i=parts.length-1;i>=0;i--){
      const p=parts[i]; p.x+=p.vx*dt; p.y+=p.vy*dt; p.vy+=120*dt; p.life-=dt;
      if(p.life<=0) parts.splice(i,1);
    }
  }

  function glowCircle(x,y,r,col,blur){
    ctx.save();
    ctx.shadowColor=col; ctx.shadowBlur=blur;
    ctx.fillStyle=col;
    ctx.beginPath(); ctx.arc(x,y,r,0,6.283); ctx.fill();
    ctx.restore();
  }

  function draw(){
    ctx.save();
    if(shake>0) ctx.translate((Math.random()-0.5)*shake,(Math.random()-0.5)*shake);

    const f=pollution/100, g=ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0, `rgb(${10+70*f},${45+20*f},${70-10*f})`);
    g.addColorStop(1, `rgb(${8+60*f},${28+20*f},${46-8*f})`);
    ctx.fillStyle=g; ctx.fillRect(0,0,W,H);

    // rising glowing bubbles
    for(let i=0;i<10;i++){
      const bx=(i*93+ (i%2? -time*22 : time*16))%(W+40)-20;
      const by=H-((time*40+i*70)%(H+60));
      ctx.save(); ctx.globalAlpha=0.14; ctx.shadowColor=COOL; ctx.shadowBlur=12;
      ctx.strokeStyle=COOL; ctx.lineWidth=1.4;
      ctx.beginPath(); ctx.arc(bx,by,3+((i*37)%5),0,6.283); ctx.stroke();
      ctx.restore();
    }

    parts.forEach(p=>{ ctx.globalAlpha=Math.max(0,p.life); glowCircle(p.x,p.y,p.r,p.col,10); });
    ctx.globalAlpha=1;

    trash.forEach(gr=>{
      const d=TRASH[gr.type];
      glowCircle(gr.x,gr.y,gr.r,d.col,16);
    });

    beams.forEach(b=>glowCircle(b.x,b.y,4,GOOD,18));

    drops.forEach(p=>{
      const col = p.kind==='boost'?GOOD:COOL;
      ctx.save(); ctx.shadowColor=col; ctx.shadowBlur=22; ctx.fillStyle=col;
      ctx.beginPath(); ctx.roundRect(p.x-13,p.y-13,26,26,7); ctx.fill(); ctx.restore();
    });

    // player: glowing sub with net
    if(!(player.inv>0 && Math.floor(time*16)%2)){
      ctx.save(); ctx.translate(player.x,player.y);
      ctx.shadowColor=player.boost>0?GOOD:COOL; ctx.shadowBlur=26;
      ctx.fillStyle='#dfe9f0';
      ctx.beginPath(); ctx.roundRect(-28,-14,56,28,12); ctx.fill();
      ctx.fillStyle=player.boost>0?GOOD:COOL;
      ctx.beginPath(); ctx.roundRect(-12,-24,24,12,5); ctx.fill();
      ctx.shadowBlur=0;
      ctx.restore();
    }
    ctx.restore();

    // HUD with text glow
    ctx.textAlign='left';
    ctx.shadowColor=GOOD; ctx.shadowBlur=10;
    ctx.fillStyle=INK; ctx.font='bold 22px Space Grotesk, system-ui';
    ctx.fillText('SCORE '+score, 18, 32);
    ctx.shadowBlur=0;
    ctx.font='13px IBM Plex Mono, monospace'; ctx.fillStyle='rgba(234,241,245,.7)';
    ctx.fillText('BEST '+best, 18, 52);
    if(mult()>1){
      ctx.shadowColor=GOOD; ctx.shadowBlur=10;
      ctx.fillStyle=GOOD; ctx.font='bold 15px IBM Plex Mono, monospace';
      ctx.fillText('COMBO ×'+mult(), 18, 74); ctx.shadowBlur=0;
    }

    ctx.textAlign='right'; ctx.shadowColor=COOL; ctx.shadowBlur=10;
    ctx.fillStyle=INK; ctx.font='bold 18px Space Grotesk, system-ui';
    ctx.fillText('WAVE '+wave+' / '+MAX_WAVE, W-18, 32); ctx.shadowBlur=0;

    const bw=280, bx=W/2-bw/2;
    ctx.fillStyle='rgba(0,0,0,.4)'; ctx.beginPath(); ctx.roundRect(bx,14,bw,16,8); ctx.fill();
    const barCol = pollution<40?GOOD:pollution<75?'#facc15':HEAT;
    ctx.save(); ctx.shadowColor=barCol; ctx.shadowBlur=14; ctx.fillStyle=barCol;
    ctx.beginPath(); ctx.roundRect(bx,14,bw*(pollution/100),16,8); ctx.fill(); ctx.restore();
    ctx.fillStyle='#fff'; ctx.font='bold 11px IBM Plex Mono, monospace'; ctx.textAlign='center';
    ctx.fillText('OCEAN POLLUTION '+Math.round(pollution)+' / 100', W/2, 26);

    if(banner.t>0){
      ctx.globalAlpha=Math.min(1,banner.t);
      ctx.textAlign='center'; ctx.shadowColor=GOOD; ctx.shadowBlur=20;
      ctx.fillStyle='#fff'; ctx.font='bold 32px Space Grotesk, system-ui';
      ctx.fillText(banner.txt, W/2, H/2-40);
      ctx.shadowBlur=0; ctx.globalAlpha=1;
    }
  }

  function overlay(title,lines,titleCol){
    ctx.fillStyle='rgba(4,14,20,.86)'; ctx.fillRect(0,0,W,H);
    ctx.textAlign='center';
    ctx.shadowColor=titleCol; ctx.shadowBlur=32;
    ctx.fillStyle=titleCol; ctx.font='bold 42px Space Grotesk, system-ui';
    ctx.fillText(title, W/2, H/2-70);
    ctx.shadowBlur=0;
    ctx.fillStyle=INK; ctx.font='15px IBM Plex Sans, system-ui';
    lines.forEach((l,i)=>ctx.fillText(l, W/2, H/2-18+i*26));
  }

  let last=performance.now();
  function loop(now){
    const dt=Math.min(0.033,(now-last)/1000); last=now;
    if(state==='play'){ update(dt); draw(); }
    else if(state==='menu'){
      ctx.fillStyle='#04141c'; ctx.fillRect(0,0,W,H);
      overlay('OCEAN CLEAN-UP', [
        'Sweep three waves of drifting plastic before it sinks.',
        '',
        'ARROWS / A-D to move  ·  SPACE or click to net trash  ·  mouse/touch to steer',
        'Bottles · Bags (split!) · Nets — clear all 3 waves to win',
        'Green pickup = triple net   Cyan pickup = pollution −20',
        '',
        'Press ENTER or click to start'
      ], COOL);
    } else if(state==='win'){
      draw();
      overlay('🌊 THANK YOU FOR SAVING THE OCEAN 🐢', [
        'Final score: '+score+'   ·   Best: '+best,
        'All 3 waves cleared — the water runs clean again.',
        '', 'Press ENTER or click to play again'
      ], GOOD);
    } else {
      draw();
      overlay('OCEAN POLLUTION CRITICAL', [
        'Final score: '+score+'   ·   Best: '+best,
        'You made it to wave '+wave+' of '+MAX_WAVE,
        '', 'Press ENTER or click to try again'
      ], HEAT);
    }
    requestAnimationFrame(loop);
  }

  function start(){ if(state!=='play'){ reset(); state='play'; } }

  window.addEventListener('keydown', e=>{
    if(document.getElementById('page-ocean').style.display !== 'block') return;
    keys[e.key]=true;
    if(e.key===' '||e.key.startsWith('Arrow')) e.preventDefault();
    if(e.key==='Enter') start();
  });
  window.addEventListener('keyup', e=>keys[e.key]=false);

  function px(e){ const r=cv.getBoundingClientRect(); return (e.clientX-r.left)*(W/r.width); }
  cv.addEventListener('pointerdown', e=>{ ptr.down=true; ptr.active=true; ptr.x=px(e); start(); });
  window.addEventListener('pointerup', ()=>ptr.down=false);
  cv.addEventListener('pointermove', e=>{ ptr.active=true; ptr.x=px(e); });

  requestAnimationFrame(loop);
})();
</script>


