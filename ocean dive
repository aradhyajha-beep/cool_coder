class Game:
    def __init__(self):
        self.state = "start"  # start, playing, gameover
        self.best = 0
        self.reset()

    def reset(self):
        self.score = 0
        self.oxygen = 100.0
        self.depth = 0.0
        self.elapsed = 0.0
        self.sub = Submarine()
        self.debris = [Debris(random.uniform(0, HEIGHT)) for _ in range(6)]
        self.jellies = []
        self.currents = []
        self.bubbles = [Bubble(random.uniform(0, HEIGHT)) for _ in range(50)]
        self.particles = []

    def start(self):
        self.reset()
        self.state = "playing"
        music.start()

    def end(self):
        self.state = "gameover"
        music.stop()
        if self.score > self.best:
            self.best = self.score

    def update(self, dt, keys):
        if self.state != "playing":
            for b in self.bubbles:
                b.update()
            return

        self.elapsed += dt
        self.depth += dt * 6

        spawn_rate = max(0.006, 0.02 - self.depth * 0.00002)
        if random.random() < spawn_rate * dt * 60:
            self.debris.append(Debris(depth=self.depth))
        if random.random() < spawn_rate * 0.55 * dt * 60:
            self.jellies.append(Jelly(depth=self.depth))
        if random.random() < 0.002 * dt * 60:
            self.currents.append(Current())

        self.sub.update(keys, self.currents)
        self.oxygen -= dt * (1.1 + self.depth * 0.0012)

        for b in self.bubbles:
            b.update()
        for c in self.currents:
            c.update(dt)
        self.currents = [c for c in self.currents if c.y < HEIGHT + 80]

        for d in self.debris:
            d.update()
        survivors = []
        for d in self.debris:
            dist = math.hypot(d.x - self.sub.x, d.y - self.sub.y)
            if dist < d.r + self.sub.r - 6:
                self.score += 10
                self.oxygen = min(100, self.oxygen + 6)
                for _ in range(10):
                    self.particles.append(Particle(d.x, d.y, d.type["color"]))
            elif d.y < HEIGHT + 40:
                survivors.append(d)
        self.debris = survivors

        for j in self.jellies:
            j.update()
        for j in self.jellies:
            dist = math.hypot(j.x - self.sub.x, j.y - self.sub.y)
            if dist < j.r + self.sub.r - 10 and not j.hit:
                self.oxygen -= 22
                j.hit = True
                j.hit_timer = 20
                for _ in range(10):
                    self.particles.append(Particle(self.sub.x, self.sub.y, DANGER))
        self.jellies = [j for j in self.jellies if j.y < HEIGHT + 40 and (not j.hit or j.hit_timer > -30)]

        for p in self.particles:
            p.update(dt)
        self.particles = [p for p in self.particles if p.life > 0]

        music.update(min(1.0, self.depth / 500))

        if self.oxygen <= 0:
            self.end()


game = Game()


