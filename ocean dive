DEBRIS_TYPES = [
    {"shape": "bottle", "color": (255, 176, 32), "glow": (255, 219, 122)},
    {"shape": "can", "color": (255, 107, 61), "glow": (255, 179, 122)},
    {"shape": "bag", "color": (57, 214, 255), "glow": (174, 240, 255)},
    {"shape": "net", "color": (255, 244, 214), "glow": (255, 255, 255)},
]


class Submarine:
    def __init__(self):
        self.x = WIDTH / 2
        self.y = HEIGHT * 0.3
        self.vx = 0.0
        self.vy = 0.0
        self.r = 24
        self.tilt = 0.0

    def update(self, keys, currents):
        ax = ay = 0.0
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            ax -= 1
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            ax += 1
        if keys[pygame.K_UP] or keys[pygame.K_w]:
            ay -= 1
        if keys[pygame.K_DOWN] or keys[pygame.K_s]:
            ay += 1

        accel = 0.55
        self.vx += ax * accel
        self.vy += ay * accel
        self.vx *= 0.9
        self.vy *= 0.9
        self.tilt = self.vx * 0.03

        for c in currents:
            if c.y - 20 < self.y < c.y + c.h + 20:
                self.vx += c.dir * c.strength * 0.08

        self.x += self.vx
        self.y += self.vy
        self.x = max(self.r, min(WIDTH - self.r, self.x))
        self.y = max(self.r + 40, min(HEIGHT - self.r - 10, self.y))

    def draw(self, surf, depth):
        light_strength = min(0.5, 0.15 + depth * 0.0004)
        light_r = 100
        light_surf = pygame.Surface((light_r * 2, light_r * 2), pygame.SRCALPHA)
        for i in range(light_r, 0, -2):
            a = int(light_strength * 255 * (i / light_r) * 0.15)
            pygame.draw.circle(light_surf, (230, 255, 245, a), (light_r, light_r), i)
        surf.blit(light_surf, (self.x - light_r, self.y - light_r), special_flags=pygame.BLEND_RGBA_ADD)

        body = pygame.Surface((90, 60), pygame.SRCALPHA)
        cx, cy = 45, 30
        pygame.draw.ellipse(body, (245, 236, 216), (cx - 26, cy - 16, 52, 32))
        pygame.draw.ellipse(body, ABYSS, (cx - 26, cy - 16, 52, 32), 3)
        pygame.draw.circle(body, GLOW, (cx + 6, cy), 9)
        pygame.draw.circle(body, ABYSS, (cx + 6, cy), 9, 2)
        pygame.draw.polygon(
            body, (255, 122, 92),
            [(cx - 22, cy), (cx - 36, cy - 9), (cx - 36, cy + 9)],
        )
        pygame.draw.polygon(
            body, ABYSS,
            [(cx - 22, cy), (cx - 36, cy - 9), (cx - 36, cy + 9)], 2,
        )
        pygame.draw.line(body, (245, 236, 216), (cx + 20, cy + 6), (cx + 32, cy + 15), 3)

        rotated = pygame.transform.rotate(body, -math.degrees(self.tilt))
        rect = rotated.get_rect(center=(self.x, self.y))
        surf.blit(rotated, rect)


class Debris:
    def __init__(self, y=None, depth=0):
        self.type = random.choice(DEBRIS_TYPES)
        self.r = random.uniform(14, 20)
        self.x = random.uniform(30, WIDTH - 30)
        self.y = y if y is not None else -30
        self.bob = random.uniform(0, math.pi * 2)
        self.vy = 0.4 + random.uniform(0, 0.6) + min(depth / 400, 1.5)

    def update(self):
        self.y += self.vy
        self.bob += 0.06
        self.x += math.sin(self.bob) * 0.4

    def draw(self, surf):
        glow_r = int(self.r + 14)
        glow_surf = pygame.Surface((glow_r * 2, glow_r * 2), pygame.SRCALPHA)
        for i in range(glow_r, 0, -2):
            a = int(140 * (i / glow_r))
            pygame.draw.circle(glow_surf, (*self.type["glow"], a), (glow_r, glow_r), i)
        surf.blit(glow_surf, (self.x - glow_r, self.y - glow_r), special_flags=pygame.BLEND_RGBA_ADD)

        color = self.type["color"]
        outline = (3, 16, 28)
        shape = self.type["shape"]
        x, y = int(self.x), int(self.y)
        if shape == "bottle":
            rect = pygame.Rect(x - 6, y - 16, 12, 32)
            pygame.draw.rect(surf, color, rect, border_radius=4)
            pygame.draw.rect(surf, outline, rect, 2, border_radius=4)
            pygame.draw.rect(surf, color, (x - 3, y - 20, 6, 6))
        elif shape == "can":
            rect = pygame.Rect(x - 9, y - 13, 18, 26)
            pygame.draw.rect(surf, color, rect, border_radius=3)
            pygame.draw.rect(surf, outline, rect, 2, border_radius=3)
        elif shape == "bag":
            pygame.draw.ellipse(surf, color, (x - 13, y - 16, 26, 32))
            pygame.draw.ellipse(surf, outline, (x - 13, y - 16, 26, 32), 2)
        else:  # net
            for i in range(-10, 11, 6):
                pygame.draw.line(surf, color, (x + i, y - 10), (x + i, y + 10), 2)
                pygame.draw.line(surf, color, (x - 10, y + i), (x + 10, y + i), 2)
            pygame.draw.rect(surf, (3, 16, 28, 150), (x - 10, y - 10, 20, 20), 1)


class Jelly:
    def __init__(self, y=None, depth=0):
        self.r = random.uniform(16, 24)
        self.x = random.uniform(30, WIDTH - 30)
        self.y = y if y is not None else -40
        self.phase = random.uniform(0, math.pi * 2)
        self.vy = 0.5 + random.uniform(0, 0.5) + min(depth / 500, 1.2)
        self.sway = 20 + random.uniform(0, 20)
        self.hit = False
        self.hit_timer = 0

    def update(self):
        self.y += self.vy
        self.phase += 0.05
        self.x += math.sin(self.phase) * (self.sway * 0.02)
        if self.hit:
            self.hit_timer -= 1

    def draw(self, surf, t):
        pulse = 0.5 + 0.5 * math.sin(t * 4 + self.phase)
        halo_r = int(self.r + 10 + pulse * 6)
        halo_surf = pygame.Surface((halo_r * 2, halo_r * 2), pygame.SRCALPHA)
        a_base = 0.35 + pulse * 0.15
        for i in range(halo_r, 0, -2):
            a = int(255 * a_base * (i / halo_r))
            pygame.draw.circle(halo_surf, (255, 77, 94, a), (halo_r, halo_r), i)
        surf.blit(halo_surf, (self.x - halo_r, self.y - halo_r), special_flags=pygame.BLEND_RGBA_ADD)

        color = (255, 77, 94) if self.hit else (232, 121, 249)
        x, y, r = int(self.x), int(self.y), int(self.r)
        cap = pygame.Surface((r * 2, r * 2), pygame.SRCALPHA)
        pygame.draw.circle(cap, color, (r, r), r)
        pygame.draw.rect(cap, (0, 0, 0, 0), (0, r, r * 2, r))  # keep top half only via mask below
        top_half = pygame.Surface((r * 2, r), pygame.SRCALPHA)
        top_half.blit(cap, (0, 0), (0, 0, r * 2, r))
        surf.blit(top_half, (x - r, y - r))
        pygame.draw.arc(surf, (3, 16, 28), (x - r, y - r, r * 2, r * 2), math.pi, 2 * math.pi, 2)

        for i in (-1, 0, 1):
            sway = math.sin(self.phase + i) * 6
            start = (x + i * r * 0.6, y)
            mid = (x + i * r * 0.6 + sway, y + r * 0.8)
            end = (x + i * r * 0.5 + sway, y + r * 1.5)
            pygame.draw.lines(surf, color, False, [start, mid, end], 3)


class Current:
    def __init__(self, y=None):
        self.y = y if y is not None else -60
        self.h = 50
        self.dir = random.choice([-1, 1])
        self.strength = 0.6 + random.uniform(0, 0.8)

    def update(self, dt):
        self.y += dt * 40

    def draw(self, surf, t):
        band = pygame.Surface((WIDTH, self.h), pygame.SRCALPHA)
        band.fill((*FOAM, 20))
        surf.blit(band, (0, self.y))
        for x in range(0, WIDTH, 30):
            yy = self.y + self.h / 2 + math.sin(x * 0.05 + t * 2) * 6
            pygame.draw.line(surf, (*FOAM, 90), (x, yy), (x + self.dir * 14, yy), 2)


class Particle:
    def __init__(self, x, y, color):
        self.x, self.y = x, y
        self.vx = random.uniform(-1.5, 1.5)
        self.vy = random.uniform(-2.5, -0.5)
        self.life = 1.0
        self.color = color

    def update(self, dt):
        self.x += self.vx
        self.y += self.vy
        self.vy += 0.05
        self.life -= dt * 2

    def draw(self, surf):
        if self.life > 0:
            a = max(0, min(255, int(self.life * 255)))
            s = pygame.Surface((6, 6), pygame.SRCALPHA)
            pygame.draw.circle(s, (*self.color, a), (3, 3), 3)
            surf.blit(s, (self.x - 3, self.y - 3))


class Bubble:
    def __init__(self, y=None):
        self.x = random.uniform(0, WIDTH)
        self.y = y if y is not None else HEIGHT + 20
        self.r = random.uniform(1.5, 4.5)
        self.speed = random.uniform(0.4, 1.2)
        self.drift = random.uniform(-0.15, 0.15)

    def update(self):
        self.y -= self.speed
        self.x += self.drift
        if self.y < -10:
            self.y = HEIGHT + 10
            self.x = random.uniform(0, WIDTH)

    def draw(self, surf):
        pygame.draw.circle(
            surf, (200, 240, 230), (int(self.x), int(self.y)), max(1, int(self.r))
        )


