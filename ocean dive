def lerp_color(c1, c2, t):
    return tuple(int(c1[i] + (c2[i] - c1[i]) * t) for i in range(3))


def bg_color_at(depth):
    t = min(depth / 900, 1)
    return lerp_color(MID_TEAL, ABYSS, t)


def draw_background(surf, depth, t):
    top = bg_color_at(depth)
    for y in range(0, HEIGHT, 4):
        f = y / HEIGHT
        col = lerp_color(top, ABYSS, f)
        pygame.draw.rect(surf, col, (0, y, WIDTH, 4))

    ray_alpha = max(0, 0.12 - depth * 0.0002)
    if ray_alpha > 0:
        ray_surf = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        for i in range(5):
            x = WIDTH * (0.15 + i * 0.2)
            poly = pygame.Surface((40, int(HEIGHT * 0.7)), pygame.SRCALPHA)
            poly.fill((191, 255, 233, int(ray_alpha * 255)))
            rotated = pygame.transform.rotate(poly, -9)
            ray_surf.blit(rotated, (x - 20, 0))
        surf.blit(ray_surf, (0, 0))


def draw_hud(surf):
    def block(x, y, w, label, value):
        panel = pygame.Surface((w, 52), pygame.SRCALPHA)
        panel.fill((3, 16, 28, 115))
        pygame.draw.rect(panel, (*FOAM, 60), (0, 0, w, 52), 1, border_radius=10)
        surf.blit(panel, (x, y))
        lbl = FONT_TINY.render(label.upper(), True, FOAM)
        surf.blit(lbl, (x + 12, y + 6))
        val = FONT_HUD.render(value, True, SAND)
        surf.blit(val, (x + 12, y + 22))

    block(18, 16, 140, "Collected", str(game.score))
    block(WIDTH - 158, 16, 140, "Depth", f"{int(game.depth)}m")

    # oxygen bar in the middle
    ox_x, ox_y, ox_w = WIDTH / 2 - 100, 16, 200
    panel = pygame.Surface((ox_w, 52), pygame.SRCALPHA)
    panel.fill((3, 16, 28, 115))
    pygame.draw.rect(panel, (*FOAM, 60), (0, 0, ox_w, 52), 1, border_radius=10)
    surf.blit(panel, (ox_x, ox_y))
    lbl = FONT_TINY.render("OXYGEN", True, FOAM)
    surf.blit(lbl, (ox_x + 12, ox_y + 6))
    bar_w = ox_w - 24
    pygame.draw.rect(surf, (255, 255, 255, 30), (ox_x + 12, ox_y + 28, bar_w, 8), border_radius=4)
    pct = max(0, game.oxygen) / 100
    if pct < 0.25:
        col = DANGER
    elif pct < 0.55:
        col = (224, 169, 78)
    else:
        col = GLOW
    pygame.draw.rect(surf, col, (ox_x + 12, ox_y + 28, int(bar_w * pct), 8), border_radius=4)

    mute_label = "M: unmute" if music.muted else "M: mute"
    txt = FONT_TINY.render(mute_label, True, SAND)
    surf.blit(txt, (WIDTH - 90, HEIGHT - 30))

    legend = FONT_TINY.render(
        "debris = O2+points   jellyfish = damage   band = current", True, (233, 217, 184)
    )
    surf.blit(legend, (WIDTH / 2 - legend.get_width() / 2, HEIGHT - 30))


def draw_start_screen(surf):
    overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    overlay.fill((3, 16, 28, 210))
    surf.blit(overlay, (0, 0))

    title = FONT_BIG.render("DEEP CLEAN", True, SAND)
    surf.blit(title, (WIDTH / 2 - title.get_width() / 2, HEIGHT * 0.28))

    sub = FONT_MED.render("a dive against the drift", True, FOAM)
    surf.blit(sub, (WIDTH / 2 - sub.get_width() / 2, HEIGHT * 0.28 + 70))

    best = FONT_SMALL.render(f"best: {game.best}", True, FOAM)
    surf.blit(best, (WIDTH / 2 - best.get_width() / 2, HEIGHT * 0.28 + 110))

    prompt = FONT_HUD.render("Press SPACE to begin dive", True, GLOW)
    surf.blit(prompt, (WIDTH / 2 - prompt.get_width() / 2, HEIGHT * 0.55))

    lines = [
        "Arrow keys / WASD to move.",
        "Scoop debris for points + oxygen.",
        "Avoid jellyfish — they drain your air fast.",
        "Press M to mute music.",
    ]
    for i, line in enumerate(lines):
        t = FONT_SMALL.render(line, True, (233, 217, 184))
        surf.blit(t, (WIDTH / 2 - t.get_width() / 2, HEIGHT * 0.62 + i * 22))


def draw_end_screen(surf):
    overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    overlay.fill((3, 16, 28, 225))
    surf.blit(overlay, (0, 0))

    label = FONT_SMALL.render("DIVE COMPLETE", True, FOAM)
    surf.blit(label, (WIDTH / 2 - label.get_width() / 2, HEIGHT * 0.32))

    score_txt = FONT_BIG.render(str(game.score), True, GLOW)
    surf.blit(score_txt, (WIDTH / 2 - score_txt.get_width() / 2, HEIGHT * 0.36))

    depth_txt = FONT_SMALL.render(
        f"reached {int(game.depth)}m  ·  best {game.best}", True, FOAM
    )
    surf.blit(depth_txt, (WIDTH / 2 - depth_txt.get_width() / 2, HEIGHT * 0.36 + 90))

    prompt = FONT_HUD.render("Press SPACE to dive again", True, GLOW)
    surf.blit(prompt, (WIDTH / 2 - prompt.get_width() / 2, HEIGHT * 0.55))


# --------------------------------------------------------------------------
# Main loop
# --------------------------------------------------------------------------

def main():
    running = True
    while running:
        dt = clock.tick(60) / 1000.0
        t = pygame.time.get_ticks() / 1000.0

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False
                elif event.key == pygame.K_m:
                    music.toggle_mute()
                elif event.key in (pygame.K_SPACE, pygame.K_RETURN):
                    if game.state in ("start", "gameover"):
                        game.start()

        keys = pygame.key.get_pressed()
        game.update(dt, keys)

        draw_background(screen, game.depth, t)

        for c in game.currents:
            c.draw(screen, t)
        for b in game.bubbles:
            b.draw(screen)
        for d in game.debris:
            d.draw(screen)
        for j in game.jellies:
            j.draw(screen, t)
        for p in game.particles:
            p.draw(screen)
        if game.state in ("playing", "gameover"):
            game.sub.draw(screen, game.depth)

        if game.state == "playing":
            draw_hud(screen)
        elif game.state == "start":
            draw_start_screen(screen)
        elif game.state == "gameover":
            draw_hud(screen)
            draw_end_screen(screen)

        pygame.display.flip()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
