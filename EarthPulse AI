{trees:800,greenRoofM2:1200,coolRoofM2:1000,rainGardenM2:700,cyclingDays:5,solarKW:80,windKW:100,pavedRemovedM2:900,tempDropC:8.16,aqiDrop:110,floodRisk:16,carbonSavedT:179,energySavedKWh:306200}];

const _X=DATA.map(r=>F.map(k=>r[k])),_n=_X.length,_d=F.length;
const _mean=Array(_d).fill(0),_std=Array(_d).fill(0);
_X.forEach(r=>r.forEach((v,j)=>_mean[j]+=v/_n));
_X.forEach(r=>r.forEach((v,j)=>_std[j]+=(v-_mean[j])**2/_n));
for(let j=0;j<_d;j++)_std[j]=Math.sqrt(_std[j])||1;
const _Z=_X.map(r=>r.map((v,j)=>(v-_mean[j])/_std[j]));
const _M={};
T.forEach(t=>{const y=DATA.map(r=>r[t]);let w=Array(_d).fill(0),b=0;
  for(let e=0;e<4000;e++){const gw=Array(_d).fill(0);let gb=0;
    for(let i=0;i<_n;i++){const p=_Z[i].reduce((s,v,j)=>s+v*w[j],b),er=p-y[i];
      for(let j=0;j<_d;j++)gw[j]+=2*er*_Z[i][j]/_n; gb+=2*er/_n;}
    for(let j=0;j<_d;j++)w[j]-=.08*gw[j]; b-=.08*gb;}
  _M[t]={w,b};});
const marginal={};
T.forEach(t=>{ marginal[t]={}; F.forEach((k,j)=>marginal[t][k]=_M[t].w[j]/_std[j]); });

const DEMO = { lat:1.3521, lng:103.8198, demo:true };

function getUserLocation(){
  return new Promise((resolve, reject)=>{
    if(!('geolocation' in navigator)){ reject(new Error('unsupported')); return; }
    navigator.geolocation.getCurrentPosition(
      pos => resolve({ lat:pos.coords.latitude, lng:pos.coords.longitude, demo:false }),
      err => reject(err),
      { enableHighAccuracy:false, timeout:9000, maximumAge:600000 }
    );
  });
}
async function reverseGeocode(lat, lng){
  try{
    const url = `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lng}&localityLanguage=en`;
    const r = await fetch(url); if(!r.ok) throw new Error('geocode');
    const d = await r.json();
    const city = d.city || d.locality || d.principalSubdivision || '';
    return { area:d.locality || city || 'Your area', city:city||'Your area', region:d.principalSubdivision||'', country:d.countryName||'', ok:true };
  }catch(e){ return { area:'Your area', city:'Your area', region:'', country:'', ok:false }; }
}
async function forwardGeocode(query){
  const url = `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=1&language=en&format=json`;
  const r = await fetch(url); if(!r.ok) throw new Error('search');
  const d = await r.json(); if(!d.results || !d.results.length) throw new Error('no match');
  const m = d.results[0];
  return { lat:m.latitude, lng:m.longitude, demo:false, place:{ area:m.name, city:m.name, region:m.admin1||'', country:m.country||'', ok:true } };
}
async function fetchLocalWeather(lat, lng){
  try{
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current=temperature_2m,relative_humidity_2m,precipitation,cloud_cover,wind_speed_10m&daily=precipitation_sum&forecast_days=1&timezone=auto`;
    const r = await fetch(url); if(!r.ok) throw new Error('weather');
    const d = await r.json(); const c = d.current || {};
    return { ok:true, temp:c.temperature_2m, humidity:c.relative_humidity_2m,
      precip:(d.daily&&d.daily.precipitation_sum&&d.daily.precipitation_sum[0])||c.precipitation||0,
      cloud:c.cloud_cover, wind:c.wind_speed_10m };
  }catch(e){ return { ok:false }; }
}

function clamp(v,lo,hi){ return Math.max(lo, Math.min(hi, v)); }

function buildLocationBaseline(place, weather, coords){
  const absLat = Math.abs(coords.lat);
  const climateTemp = clamp(30 - absLat*0.45, -5, 32);
  const temp = (weather&&weather.ok&&weather.temp!=null) ? weather.temp : climateTemp;
  const humidity = (weather&&weather.ok&&weather.humidity!=null) ? weather.humidity : clamp(80 - absLat*0.5, 30, 90);
  const tropical = absLat<23.5, temperate = absLat<55;
  let rainScore = tropical ? 1.35 : temperate ? 1.0 : 0.75;
  if(weather&&weather.ok&&weather.precip!=null){ if(weather.precip>8) rainScore=Math.max(rainScore,1.45); else if(weather.precip<0.5) rainScore=Math.min(rainScore,0.85); }
  const rainfallProfile = rainScore>=1.25 ? 'High' : rainScore>=0.9 ? 'Moderate' : 'Low';
  const cloud = (weather&&weather.ok&&weather.cloud!=null) ? weather.cloud : 45;
  const solarScore = clamp(1.35 - absLat/90*0.7 - cloud/100*0.3, 0.6, 1.4);
  const solarPotential = solarScore>=1.15 ? 'High' : solarScore>=0.9 ? 'Moderate' : 'Low';
  const windMs = (weather&&weather.ok&&weather.wind!=null) ? weather.wind : 12;
  const windScore = clamp(0.65 + windMs/22, 0.6, 1.4);
  const windPotential = windScore>=1.15 ? 'High' : windScore>=0.9 ? 'Moderate' : 'Low';
  const density='urban';
  const urbanHeat = temp>=30 ? 'High' : temp>=24 ? 'Moderate' : 'Low';
  const greenCover = clamp(Math.round((temperate?32:26) - 6 + (rainScore-1)*15), 8, 55);
  const floodBaseline = clamp(Math.round(45 + (rainScore-1)*40 + 12), 15, 85);
  const aqiBaseline = clamp(Math.round(55 + 15 - (greenCover-25)*0.4), 20, 130);
  const heatFactor = clamp(0.8 + (temp-22)/25 + (urbanHeat==='High'?0.15:0), 0.7, 1.5);
  return { coords, place, isEstimate:!(weather&&weather.ok),
    temp:Math.round(temp), humidity:Math.round(humidity), rainfallProfile, urbanHeat, greenCover,
    solarPotential, windPotential, density, floodBaseline, aqiBaseline,
    factors:{ heat:heatFactor, rain:clamp(rainScore,0.6,1.6), solar:solarScore, wind:windScore } };
}
function factorFor(b, target, lever){
  const f=b.factors;
  if(target==='tempDropC' && (lever==='trees'||lever==='greenRoofM2'||lever==='coolRoofM2'||lever==='pavedRemovedM2')) return f.heat;
  if(target==='floodRisk' && (lever==='rainGardenM2'||lever==='pavedRemovedM2'||lever==='greenRoofM2'||lever==='trees')) return f.rain;
  if((target==='carbonSavedT'||target==='energySavedKWh') && lever==='solarKW') return f.solar;
  if((target==='carbonSavedT'||target==='energySavedKWh') && lever==='windKW') return f.wind;
  return 1;
}
function calculateInterventionImpact(totals, b){
  const out={};
  T.forEach(t=>{ let delta=0; F.forEach(k=>{ delta += marginal[t][k]*totals[k]*factorFor(b,t,k); });
    out[t] = (t==='floodRisk') ? clamp(b.floodBaseline+delta,0,100) : Math.max(0,delta); });
  out.tempDropC = clamp(out.tempDropC,0,12);
  return out;
}

let baseline=null, map=null, placeLayer=null;
const totals=Object.fromEntries(F.map(k=>[k,0]));
const qty=Object.fromEntries(LEVERS.map(l=>[l.key,l.def]));
let armed=null;

document.getElementById('chips').innerHTML = LEVERS.map(l=>
  `<div class="chip" data-key="${l.key}"><div class="ico">${l.icon}</div>
     <div class="txt"><span class="lbl">${l.label}</span><span class="sub">${l.min}–${l.max} ${l.unit}</span></div></div>`).join('');
document.getElementById('cards').innerHTML = TMETA.map(m=>
  `<div class="metric"><div class="m-lbl">${m.icon} ${m.label}</div>
     <div class="m-val" id="v-${m.key}">—</div><div class="bar"><i id="b-${m.key}"></i></div>
     <div class="m-base" id="base-${m.key}"></div></div>`).join('');

const chipEls=[...document.querySelectorAll('.chip')];
const qtyBox=document.getElementById('qtyBox');
const qtySlider=document.getElementById('qtySlider');
const qtyVal=document.getElementById('qtyVal');
const qtyLabel=document.getElementById('qtyLabel');
const qtyHint=document.getElementById('qtyHint');

function syncQty(){
  if(!armed){ qtyBox.classList.add('disabled'); qtyVal.textContent='—'; qtyLabel.textContent='Amount';
    qtyHint.textContent='Pick an intervention, choose how much, then click a spot on the map.'; return; }
  const l=META[armed];
  qtyBox.classList.remove('disabled');
  qtySlider.min=l.min; qtySlider.max=l.max; qtySlider.step=l.step; qtySlider.value=qty[armed];
  qtyLabel.textContent=`How much ${l.label.toLowerCase()}?`;
  qtyVal.textContent=`${qty[armed].toLocaleString()} ${l.unit}`;
  qtyHint.textContent=`Click the map to drop ${qty[armed].toLocaleString()} ${l.unit} of ${l.label.toLowerCase()} at that spot.`;
}
qtySlider.addEventListener('input',()=>{ if(!armed) return; qty[armed]=+qtySlider.value; syncQty(); });

function setArmed(key){
  armed=(armed===key)?null:key;
  chipEls.forEach(c=>c.classList.toggle('armed', c.dataset.key===armed));
  const el=document.getElementById('satmap'); if(el) el.classList.toggle('arming', !!armed);
  syncQty();
}
chipEls.forEach(chip=>chip.addEventListener('click',()=>setArmed(chip.dataset.key)));

function placeAt(latlng, key){
  const amount = qty[key];
  totals[key] += amount;
  const icon = L.divIcon({ className:'', html:`<div class="marker-emoji">${ICON[key]}</div>`, iconSize:[24,24], iconAnchor:[12,12] });
  const mk = L.marker(latlng, { icon }).addTo(placeLayer);
  mk.bindPopup(`${ICON[key]} ${META[key].label}<br>${amount.toLocaleString()} ${META[key].unit}`);
  const l=META[key];
  const frac=(amount-l.min)/(l.max-l.min);
  const radius=clamp(25 + frac*220, 25, 260);
  L.circle(latlng, { radius, color:'#35d9a0', weight:1, fillColor:'#35d9a0', fillOpacity:0.12 }).addTo(placeLayer);
  render();
}

const FMT={ tempDropC:v=>v.toFixed(2), aqiDrop:v=>Math.round(v), floodRisk:v=>Math.round(v),
  carbonSavedT:v=>v.toFixed(1), energySavedKWh:v=>Math.round(v).toLocaleString() };

function renderProfile(){
  const b=baseline;
  const placeStr=[b.place.area,b.place.country].filter(Boolean).join(', ')||'Your area';
  document.getElementById('profileGrid').innerHTML = `
    <div class="pstat"><div class="k">📍 Location</div><div class="v" style="font-size:14px;">${placeStr}${b.coords.demo?' <span class="demo-flag">Demo</span>':''}</div></div>
    <div class="pstat"><div class="k">🌡 Current temperature</div><div class="v">${b.temp}°C</div></div>
    <div class="pstat"><div class="k">💧 Humidity</div><div class="v">${b.humidity}%</div></div>
    <div class="pstat"><div class="k">🌧 Rainfall profile</div><div class="v">${b.rainfallProfile}</div></div>
    <div class="pstat"><div class="k">🏙 Urban heat exposure</div><div class="v">${b.urbanHeat}</div></div>
    <div class="pstat"><div class="k">🌱 Estimated green cover</div><div class="v">${b.greenCover}%</div></div>
    <div class="pstat"><div class="k">☀️ Solar potential</div><div class="v">${b.solarPotential}</div></div>
    <div class="pstat"><div class="k">🌬 Wind potential</div><div class="v">${b.windPotential}</div></div>`;
  document.getElementById('estFlag').textContent = b.isEstimate ? 'AI-estimated baseline' : 'Live data + estimates';
  document.getElementById('boardPlace').textContent = placeStr;
  document.getElementById('locIndicator').innerHTML =
    `📍 <b>${b.place.area||'Your area'}${b.place.country?', '+b.place.country:''}</b>${b.coords.demo?' <span class="demo-flag">Demo</span>':''}`;
  document.getElementById('modelDiag').textContent =
    `factors — heat ×${b.factors.heat.toFixed(2)}, rain ×${b.factors.rain.toFixed(2)}, solar ×${b.factors.solar.toFixed(2)}, wind ×${b.factors.wind.toFixed(2)} · baseline flood ${b.floodBaseline}% · AQI ${b.aqiBaseline}`;
}
function render(){
  if(!baseline) return;
  const p=calculateInterventionImpact(totals, baseline);
  TMETA.forEach(m=>{
    document.getElementById('v-'+m.key).innerHTML=FMT[m.key](p[m.key])+`<small>${m.unit}</small>`;
    document.getElementById('b-'+m.key).style.width=clamp((p[m.key]/m.max)*100,0,100)+'%';
    const be=document.getElementById('base-'+m.key);
    if(m.key==='floodRisk') be.textContent=`baseline ${baseline.floodBaseline}%`;
    else if(m.key==='aqiDrop') be.textContent=`baseline AQI ${baseline.aqiBaseline}`;
    else be.textContent='';
  });
  document.getElementById('heat').textContent = p.tempDropC<.05 ? 'baseline' : '−'+p.tempDropC.toFixed(1)+'°C';
  const deployed=F.some(k=>totals[k]>0);
  document.getElementById('tally').innerHTML = deployed
    ? F.filter(k=>totals[k]>0).map(k=>`${ICON[k]} ${totals[k].toLocaleString()} ${META[k].unit}`).join('<br>')
    : '<span style="color:var(--text-faint)">nothing yet</span>';
  document.getElementById('note').textContent = baseline.isEstimate
    ? 'Limited local data available. Some results are modelled estimates.'
    : 'Interventions scaled to your local baseline.';
}

function ensureMap(){
  if(map) return;
  map = L.map('satmap', { zoomControl:true, attributionControl:true }).setView([baseline.coords.lat, baseline.coords.lng], 15);
  L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    maxZoom:19, attribution:'Tiles &copy; Esri — Source: Esri, Maxar, Earthstar Geographics'
  }).addTo(map);
  placeLayer = L.layerGroup().addTo(map);
  map.on('click', e=>{ if(armed) placeAt(e.latlng, armed); });
  const el=document.getElementById('satmap');
  chipEls.forEach(chip=>{ chip.setAttribute('draggable','true');
    chip.addEventListener('dragstart', ev=>ev.dataTransfer.setData('key', chip.dataset.key)); });
  el.addEventListener('dragover', ev=>ev.preventDefault());
  el.addEventListener('drop', ev=>{ ev.preventDefault();
    const key=ev.dataTransfer.getData('key'); if(!key) return;
    try{ placeAt(map.mouseEventToLatLng(ev), key); }catch(_){}} );
}
function clearPlacements(){
  F.forEach(k=>totals[k]=0);
  if(placeLayer) placeLayer.clearLayers();
  armed=null; chipEls.forEach(c=>c.classList.remove('armed'));
  const el=document.getElementById('satmap'); if(el) el.classList.remove('arming');
  syncQty();
}

function showGate(state, msg){
  const gate=document.getElementById('gate'), content=document.getElementById('content');
  const title=document.getElementById('gateTitle'), body=document.getElementById('gateBody');
  const row=document.getElementById('gateRow'), gmsg=document.getElementById('gateMsg');
  if(state==='detecting'){ gate.style.display=''; content.style.display='none';
    title.innerHTML='<span class="spinner"></span>Detecting your location…';
    body.textContent='EarthPulse uses your approximate location to create a local climate-resilience simulation.';
    row.style.display='none'; gmsg.style.display='none';
  } else if(state==='denied'||state==='failed'||state==='manual'){ gate.style.display=''; content.style.display='none';
    title.textContent = state==='denied' ? 'Location access was not enabled.' : 'Couldn’t detect your location.';
    body.textContent='Enter a city to continue, or use the demo location.';
    row.style.display='flex'; if(msg){ gmsg.style.display=''; gmsg.textContent=msg; } else gmsg.style.display='none';
  } else if(state==='ready'){ gate.style.display='none'; content.style.display=''; }
}

async function loadForCoords(coords, presetPlace){
  showGate('detecting');
  document.getElementById('gateTitle').innerHTML='<span class="spinner"></span>Building your local climate twin…';
  let place=presetPlace;
  try{ if(!place) place=await reverseGeocode(coords.lat,coords.lng); }
  catch(e){ place={area:'Your area',city:'Your area',region:'',country:'',ok:false}; }
  let weather; try{ weather=await fetchLocalWeather(coords.lat,coords.lng); }catch(e){ weather={ok:false}; }
  baseline=buildLocationBaseline(place, weather, coords);
  clearPlacements();
  renderProfile(); render();
  showGate('ready');
  ensureMap();
  map.setView([coords.lat, coords.lng], 15);
  setTimeout(()=>map.invalidateSize(), 60);
}
async function startFromDevice(){
  showGate('detecting');
  try{ const coords=await getUserLocation(); await loadForCoords(coords); }
  catch(err){ const denied=err&&err.code===1;
    showGate(denied?'denied':'failed', denied?'':'Location unavailable in this environment — enter a city or use the demo.'); }
}
function confirmReset(){ return !F.some(k=>totals[k]>0) || confirm('Changing location will reset the current simulation. Continue?'); }

document.getElementById('btnUseLoc').addEventListener('click', ()=>{ if(confirmReset()) startFromDevice(); });
document.getElementById('btnRetryLoc').addEventListener('click', startFromDevice);
document.getElementById('btnChangeLoc').addEventListener('click', ()=>{ if(confirmReset()) showGate('manual'); });
document.getElementById('btnRefresh').addEventListener('click', ()=>{ if(baseline) loadForCoords(baseline.coords, baseline.place); });
document.getElementById('btnDemo').addEventListener('click', ()=>{ loadForCoords({...DEMO}, {area:'Singapore',city:'Singapore',region:'',country:'Singapore',ok:true}); });
async function doCitySearch(){
  const q=document.getElementById('cityInput').value.trim();
  if(!q){ showGate('manual','Type a city or postcode first.'); return; }
  document.getElementById('gateTitle').innerHTML='<span class="spinner"></span>Finding “'+q+'”…';
  try{ const res=await forwardGeocode(q); await loadForCoords({lat:res.lat,lng:res.lng,demo:false}, res.place); }
  catch(e){ showGate('manual','No match found — try a different city name or postcode.'); }
}
document.getElementById('btnSearchCity').addEventListener('click', doCitySearch);
document.getElementById('cityInput').addEventListener('keydown', e=>{ if(e.key==='Enter') doCitySearch(); });

syncQty();
startFromDevice();
</script>
