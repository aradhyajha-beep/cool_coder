/* ============ LOCATION & BASELINE ============ */
const DEMO={lat:1.3521,lng:103.8198,demo:true};
function clamp(v,lo,hi){return Math.max(lo,Math.min(hi,v))}
function getUserLocation(){return new Promise((res,rej)=>{if(!('geolocation'in navigator)){rej(new Error('unsupported'));return;}navigator.geolocation.getCurrentPosition(p=>res({lat:p.coords.latitude,lng:p.coords.longitude,demo:false}),e=>rej(e),{enableHighAccuracy:false,timeout:9000,maximumAge:600000});})}
async function reverseGeocode(lat,lng){try{const r=await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lng}&localityLanguage=en`);if(!r.ok)throw 0;const d=await r.json();const city=d.city||d.locality||d.principalSubdivision||'';return{area:d.locality||city||'Your area',city:city||'Your area',region:d.principalSubdivision||'',country:d.countryName||'',ok:true};}catch(e){return{area:'Your area',city:'Your area',region:'',country:'',ok:false};}}
async function forwardGeocode(q){const url=`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(q)}&count=1&language=en&format=json`;const r=await fetch(url);if(!r.ok)throw 0;const d=await r.json();if(!d.results||!d.results.length)throw 0;const m=d.results[0];return{lat:m.latitude,lng:m.longitude,demo:false,place:{area:m.name,city:m.name,region:m.admin1||'',country:m.country||'',ok:true}};}
async function fetchLocalWeather(lat,lng){try{const r=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current=temperature_2m,relative_humidity_2m,precipitation,cloud_cover,wind_speed_10m&daily=precipitation_sum&forecast_days=1&timezone=auto`);if(!r.ok)throw 0;const d=await r.json(),c=d.current||{};return{ok:true,temp:c.temperature_2m,humidity:c.relative_humidity_2m,precip:(d.daily&&d.daily.precipitation_sum&&d.daily.precipitation_sum[0])||c.precipitation||0,cloud:c.cloud_cover,wind:c.wind_speed_10m};}catch(e){return{ok:false};}}
function buildLocationBaseline(place,weather,coords){
const absLat=Math.abs(coords.lat),climateTemp=clamp(30-absLat*.45,-5,32);
const temp=(weather&&weather.ok&&weather.temp!=null)?weather.temp:climateTemp;
const humidity=(weather&&weather.ok&&weather.humidity!=null)?weather.humidity:clamp(80-absLat*.5,30,90);
const tropical=absLat<23.5,temperate=absLat<55;
let rainScore=tropical?1.35:temperate?1.0:.75;
if(weather&&weather.ok&&weather.precip!=null){if(weather.precip>8)rainScore=Math.max(rainScore,1.45);else if(weather.precip<.5)rainScore=Math.min(rainScore,.85);}
const rainfallProfile=rainScore>=1.25?'High':rainScore>=.9?'Moderate':'Low';
const cloud=(weather&&weather.ok&&weather.cloud!=null)?weather.cloud:45;
const solarScore=clamp(1.35-absLat/90*.7-cloud/100*.3,.6,1.4);
const solarPotential=solarScore>=1.15?'High':solarScore>=.9?'Moderate':'Low';
const windMs=(weather&&weather.ok&&weather.wind!=null)?weather.wind:12;
const windScore=clamp(.65+windMs/22,.6,1.4);
const windPotential=windScore>=1.15?'High':windScore>=.9?'Moderate':'Low';
const urbanHeat=temp>=30?'High':temp>=24?'Moderate':'Low';
const greenCover=clamp(Math.round((temperate?32:26)-6+(rainScore-1)*15),8,55);
const floodBaseline=clamp(Math.round(45+(rainScore-1)*40+12),15,85);
const aqiBaseline=clamp(Math.round(55+15-(greenCover-25)*.4),20,130);
const heatFactor=clamp(.8+(temp-22)/25+(urbanHeat==='High'?.15:0),.7,1.5);
return{coords,place,isEstimate:!(weather&&weather.ok),temp:Math.round(temp),humidity:Math.round(humidity),rainfallProfile,urbanHeat,greenCover,solarPotential,windPotential,floodBaseline,aqiBaseline,factors:{heat:heatFactor,rain:clamp(rainScore,.6,1.6),solar:solarScore,wind:windScore}};}

/* factor scaling for both green + harmful */
function factorFor(b,target,lever){
const f=b.factors,isHarm=META[lever]&&META[lever].harmful;
if(target==='tempChange'&&(lever==='trees'||lever==='greenRoofM2'||lever==='coolRoofM2'||lever==='pavedRemovedM2'||lever==='factory'||lever==='towerBlock'||lever==='parkingLot'||lever==='deforest'||lever==='highway'))return f.heat;
if(target==='floodRisk'&&(lever==='rainGardenM2'||lever==='pavedRemovedM2'||lever==='greenRoofM2'||lever==='trees'||lever==='parkingLot'||lever==='highway'||lever==='deforest'||lever==='landfill'))return f.rain;
if((target==='carbonNet'||target==='energyNet')&&lever==='solarKW')return f.solar;
if((target==='carbonNet'||target==='energyNet')&&lever==='windKW')return f.wind;
return 1;}

function calculateImpact(totals,b){
const out={};
T.forEach(t=>{let delta=0;
FG.forEach(k=>{delta+=greenMarg[t][k]*totals[k]*factorFor(b,t,k);});
FH.forEach(k=>{if(harmMarg[k]&&harmMarg[k][t]!==undefined)delta+=harmMarg[k][t]*totals[k]*factorFor(b,t,k);});
if(t==='floodRisk')out[t]=clamp(b.floodBaseline+delta,0,100);
else out[t]=delta;});
out.tempChange=clamp(out.tempChange,-15,12);
return out;}

/* ============ APP STATE ============ */
let baseline=null,map=null,placeLayer=null;
const totals=Object.fromEntries(FA.map(k=>[k,0]));
const qty=Object.fromEntries(ALL.map(l=>[l.key,l.def]));
let armed=null;

function buildChip(l){return `<div class="chip ${l.harmful?'harmful':''}" data-key="${l.key}"><div class="ico">${l.icon}</div><div class="txt"><span class="lbl">${l.label}</span><span class="sub">${l.min}–${l.max} ${l.unit}</span></div></div>`;}
document.getElementById('greenChips').innerHTML=GREEN.map(buildChip).join('');
document.getElementById('harmChips').innerHTML=HARMFUL.map(buildChip).join('');
document.getElementById('cards').innerHTML=TMETA.map(m=>`<div class="metric"><div class="m-lbl">${m.icon} ${m.label}</div><div class="m-val neutral" id="v-${m.key}">—</div><div class="bar"><div class="fill pos" id="bp-${m.key}" style="width:0"></div><div class="fill neg" id="bn-${m.key}" style="width:0"></div></div><div class="m-base" id="base-${m.key}"></div></div>`).join('');

const chipEls=[...document.querySelectorAll('.chip')];
const qtyBox=document.getElementById('qtyBox'),qtySlider=document.getElementById('qtySlider'),qtyVal=document.getElementById('qtyVal'),qtyLabel=document.getElementById('qtyLabel'),qtyHint=document.getElementById('qtyHint');

function syncQty(){
if(!armed){qtyBox.classList.add('disabled');qtyVal.textContent='—';qtyVal.className='qty-val';qtySlider.className='';qtyLabel.textContent='Amount';qtyHint.textContent='Pick an action, choose how much, then click the map.';return;}
const l=META[armed];
qtyBox.classList.remove('disabled');
qtySlider.min=l.min;qtySlider.max=l.max;qtySlider.step=l.step;qtySlider.value=qty[armed];
qtySlider.className=l.harmful?'harm':'';
qtyLabel.textContent=`How much ${l.label.toLowerCase()}?`;
qtyVal.textContent=`${qty[armed].toLocaleString()} ${l.unit}`;
qtyVal.className=l.harmful?'qty-val harm':'qty-val';
qtyHint.textContent=`Click the map to ${l.harmful?'build':'place'} ${qty[armed].toLocaleString()} ${l.unit} of ${l.label.toLowerCase()}.`;}
qtySlider.addEventListener('input',()=>{if(!armed)return;qty[armed]=+qtySlider.value;syncQty();});

function setArmed(key){armed=(armed===key)?null:key;chipEls.forEach(c=>c.classList.toggle('armed',c.dataset.key===armed));const el=document.getElementById('satmap');if(el)el.classList.toggle('arming',!!armed);syncQty();}
chipEls.forEach(chip=>{chip.addEventListener('click',()=>setArmed(chip.dataset.key));chip.setAttribute('draggable','true');chip.addEventListener('dragstart',ev=>ev.dataTransfer.setData('key',chip.dataset.key));});

function placeAt(latlng,key){
const amount=qty[key];totals[key]+=amount;
const l=META[key],isH=l.harmful;
const icon=L.divIcon({className:'',html:`<div class="marker-emoji">${ICON[key]}</div>`,iconSize:[24,24],iconAnchor:[12,12]});
const mk=L.marker(latlng,{icon}).addTo(placeLayer);
mk.bindPopup(`${ICON[key]} ${l.label}<br>${amount.toLocaleString()} ${l.unit}`);
const frac=(amount-l.min)/(l.max-l.min);
const radius=clamp(25+frac*220,25,260);
const col=isH?'#e05252':'#35d9a0';
L.circle(latlng,{radius,color:col,weight:1,fillColor:col,fillOpacity:.14}).addTo(placeLayer);
render();}

/* ============ RENDER ============ */
function fmtAbs(key,v){
if(key==='floodRisk')return Math.round(v);
if(key==='tempChange')return Math.abs(v).toFixed(2);
if(key==='carbonNet')return Math.abs(v).toFixed(1);
if(key==='energyNet')return Math.abs(Math.round(v)).toLocaleString();
return Math.abs(Math.round(v));}

function renderProfile(){
const b=baseline,ps=[b.place.area,b.place.country].filter(Boolean).join(', ')||'Your area';
document.getElementById('profileGrid').innerHTML=`
<div class="pstat"><div class="k">📍 Location</div><div class="v" style="font-size:14px">${ps}${b.coords.demo?' <span class="demo-flag">Demo</span>':''}</div></div>
<div class="pstat"><div class="k">🌡 Temperature</div><div class="v">${b.temp}°C</div></div>
<div class="pstat"><div class="k">💧 Humidity</div><div class="v">${b.humidity}%</div></div>
<div class="pstat"><div class="k">🌧 Rainfall</div><div class="v">${b.rainfallProfile}</div></div>
<div class="pstat"><div class="k">🏙 Urban heat</div><div class="v">${b.urbanHeat}</div></div>
<div class="pstat"><div class="k">🌱 Green cover</div><div class="v">${b.greenCover}%</div></div>
<div class="pstat"><div class="k">☀️ Solar</div><div class="v">${b.solarPotential}</div></div>
<div class="pstat"><div class="k">🌬 Wind</div><div class="v">${b.windPotential}</div></div>`;
document.getElementById('estFlag').textContent=b.isEstimate?'AI-estimated baseline':'Live data + estimates';
document.getElementById('boardPlace').textContent=ps;
document.getElementById('locIndicator').innerHTML=`📍 <b>${b.place.area||'Your area'}${b.place.country?', '+b.place.country:''}</b>${b.coords.demo?' <span class="demo-flag">Demo</span>':''}`;
document.getElementById('modelDiag').textContent=`factors — heat ×${b.factors.heat.toFixed(2)}, rain ×${b.factors.rain.toFixed(2)}, solar ×${b.factors.solar.toFixed(2)}, wind ×${b.factors.wind.toFixed(2)} · baseline flood ${b.floodBaseline}% · AQI ${b.aqiBaseline}`;}

function render(){
if(!baseline)return;
const p=calculateImpact(totals,baseline);
TMETA.forEach(m=>{
const v=p[m.key],el=document.getElementById('v-'+m.key);
if(m.key==='floodRisk'){
  const delta=v-baseline.floodBaseline;
  const cls=delta<-0.5?'pos':delta>0.5?'neg':'neutral';
  el.className='m-val '+cls;
  el.innerHTML=`${Math.round(v)}<small>%</small>`;
  const pctP=clamp((-delta/baseline.floodBaseline)*50,0,50);
  const pctN=clamp((delta/baseline.floodBaseline)*50,0,50);
  document.getElementById('bp-'+m.key).style.width=pctP+'%';
  document.getElementById('bn-'+m.key).style.width=pctN+'%';
  document.getElementById('base-'+m.key).textContent=`baseline ${baseline.floodBaseline}% · ${delta>0?'+':''}${delta.toFixed(1)}`;
} else {
  const isPos=v>0.001,isNeg=v<-0.001;
  const cls=isPos?'pos':isNeg?'neg':'neutral';
  el.className='m-val '+cls;
  const sign=isPos?'':isNeg?'':'';
  const unit=isPos?m.unitPos:isNeg?m.unitNeg:m.unitPos;
  el.innerHTML=`${sign}${fmtAbs(m.key,v)}<small>${unit}</small>`;
  const pctP=clamp((v/m.max)*50,0,50);
  const pctN=clamp((-v/m.max)*50,0,50);
  document.getElementById('bp-'+m.key).style.width=pctP+'%';
  document.getElementById('bn-'+m.key).style.width=pctN+'%';
  document.getElementById('base-'+m.key).textContent='';
}});
const tc=p.tempChange;
const heatEl=document.getElementById('heat');
if(Math.abs(tc)<.05){heatEl.textContent='baseline';heatEl.className='neutral';}
else if(tc>0){heatEl.textContent='−'+tc.toFixed(1)+'°C';heatEl.className='cool';}
else{heatEl.textContent='+'+Math.abs(tc).toFixed(1)+'°C';heatEl.className='warm';}
const hasGreen=FG.some(k=>totals[k]>0),hasHarm=FH.some(k=>totals[k]>0);
const lines=[];
if(hasGreen)lines.push('<span style="color:var(--teal)">▸ Green</span>');
FG.filter(k=>totals[k]>0).forEach(k=>lines.push(`  ${ICON[k]} ${totals[k].toLocaleString()} ${META[k].unit}`));
if(hasHarm)lines.push('<span style="color:var(--red)">▸ Harmful</span>');
FH.filter(k=>totals[k]>0).forEach(k=>lines.push(`  ${ICON[k]} ${totals[k].toLocaleString()} ${META[k].unit}`));
document.getElementById('tally').innerHTML=lines.length?lines.join('<br>'):'<span style="color:var(--text-faint)">nothing yet</span>';
document.getElementById('note').textContent=baseline.isEstimate?'Limited local data. Some results are modelled estimates.':'Net impact scaled to your local baseline.';}

/* ============ MAP ============ */
function ensureMap(){if(map)return;map=L.map('satmap',{zoomControl:true}).setView([baseline.coords.lat,baseline.coords.lng],15);
L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'Tiles &copy; Esri'}).addTo(map);
placeLayer=L.layerGroup().addTo(map);
map.on('click',e=>{if(armed)placeAt(e.latlng,armed);});
const el=document.getElementById('satmap');
el.addEventListener('dragover',ev=>ev.preventDefault());
el.addEventListener('drop',ev=>{ev.preventDefault();const key=ev.dataTransfer.getData('key');if(!key)return;try{placeAt(map.mouseEventToLatLng(ev),key);}catch(_){}});}
function clearPlacements(){FA.forEach(k=>totals[k]=0);if(placeLayer)placeLayer.clearLayers();armed=null;chipEls.forEach(c=>c.classList.remove('armed'));const el=document.getElementById('satmap');if(el)el.classList.remove('arming');syncQty();}

/* ============ GATE STATES ============ */
function showGate(state,msg){const gate=document.getElementById('gate'),content=document.getElementById('content'),title=document.getElementById('gateTitle'),body=document.getElementById('gateBody'),row=document.getElementById('gateRow'),gmsg=document.getElementById('gateMsg');
if(state==='detecting'){gate.style.display='';content.style.display='none';title.innerHTML='<span class="spinner"></span>Detecting your location…';body.textContent='EarthPulse uses your approximate location to create a local climate-resilience simulation.';row.style.display='none';gmsg.style.display='none';}
else if(state==='denied'||state==='failed'||state==='manual'){gate.style.display='';content.style.display='none';title.textContent=state==='denied'?'Location access was not enabled.':'Couldn\'t detect your location.';body.textContent='Enter a city to continue, or use the demo location.';row.style.display='flex';if(msg){gmsg.style.display='';gmsg.textContent=msg;}else gmsg.style.display='none';}
else if(state==='ready'){gate.style.display='none';content.style.display='';}}

async function loadForCoords(coords,presetPlace){showGate('detecting');document.getElementById('gateTitle').innerHTML='<span class="spinner"></span>Building your local climate twin…';
let place=presetPlace;try{if(!place)place=await reverseGeocode(coords.lat,coords.lng);}catch(e){place={area:'Your area',city:'Your area',region:'',country:'',ok:false};}
let weather;try{weather=await fetchLocalWeather(coords.lat,coords.lng);}catch(e){weather={ok:false};}
baseline=buildLocationBaseline(place,weather,coords);clearPlacements();renderProfile();render();showGate('ready');ensureMap();map.setView([coords.lat,coords.lng],15);setTimeout(()=>map.invalidateSize(),60);}
async function startFromDevice(){showGate('detecting');try{const coords=await getUserLocation();await loadForCoords(coords);}catch(err){const denied=err&&err.code===1;showGate(denied?'denied':'failed',denied?'':'Location unavailable — enter a city or use the demo.');}}
function confirmReset(){return !FA.some(k=>totals[k]>0)||confirm('Changing location will reset the current simulation. Continue?');}

document.getElementById('btnUseLoc').addEventListener('click',()=>{if(confirmReset())startFromDevice();});
document.getElementById('btnRetryLoc').addEventListener('click',startFromDevice);
document.getElementById('btnChangeLoc').addEventListener('click',()=>{if(confirmReset())showGate('manual');});
document.getElementById('btnRefresh').addEventListener('click',()=>{if(baseline)loadForCoords(baseline.coords,baseline.place);});
document.getElementById('btnDemo').addEventListener('click',()=>{loadForCoords({...DEMO},{area:'Singapore',city:'Singapore',region:'',country:'Singapore',ok:true});});
async function doCitySearch(){const q=document.getElementById('cityInput').value.trim();if(!q){showGate('manual','Type a city or postcode first.');return;}
document.getElementById('gateTitle').innerHTML='<span class="spinner"></span>Finding "'+q+'"…';
try{const res=await forwardGeocode(q);await loadForCoords({lat:res.lat,lng:res.lng,demo:false},res.place);}catch(e){showGate('manual','No match found — try a different city name or postcode.');}}
document.getElementById('btnSearchCity').addEventListener('click',doCitySearch);
document.getElementById('cityInput').addEventListener('keydown',e=>{if(e.key==='Enter')doCitySearch();});

syncQty();startFromDevice();
</script>
</body>
</html>
