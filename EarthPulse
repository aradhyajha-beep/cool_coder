const TG=['td','aq','fr','cs','es'];
const X=DATA.map(r=>FG.map(k=>r[k])),n=X.length,d=FG.length;
const mn=Array(d).fill(0),sd=Array(d).fill(0);
X.forEach(r=>r.forEach((v,j)=>mn[j]+=v/n));
X.forEach(r=>r.forEach((v,j)=>sd[j]+=(v-mn[j])**2/n));
for(let j=0;j<d;j++)sd[j]=Math.sqrt(sd[j])||1;
const Z=X.map(r=>r.map((v,j)=>(v-mn[j])/sd[j]));
const Mo={};
TG.forEach(t=>{const y=DATA.map(r=>r[t]);let w=Array(d).fill(0),b=0;
for(let e=0;e<4000;e++){const gw=Array(d).fill(0);let gb=0;
for(let i=0;i<n;i++){const p=Z[i].reduce((s,v,j)=>s+v*w[j],b),er=p-y[i];
for(let j=0;j<d;j++)gw[j]+=2*er*Z[i][j]/n;gb+=2*er/n;}
for(let j=0;j<d;j++)w[j]-=.08*gw[j];b-=.08*gb;}
Mo[t]={w,b};});
const greenMarg={};
TG.forEach((t,ti)=>{greenMarg[T[ti]]={};FG.forEach((k,j)=>greenMarg[T[ti]][k]=Mo[t].w[j]/sd[j]);});

