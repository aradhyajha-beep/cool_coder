<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>EarthPulse AI — local climate twin</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<style>
:root{--ink:#0c1618;--panel:#12242a;--panel-2:#162c33;--line:#244149;--line-soft:#1b333a;--text:#dcece7;--text-dim:#7fa39c;--text-faint:#4d726c;--teal:#35d9a0;--amber:#f2a93b;--coral:#e8654a;--red:#e05252}
*{box-sizing:border-box;margin:0;padding:0}
html,body{min-height:100%;margin:0}
body{background:var(--ink);color:var(--text);font-family:'Inter',system-ui,sans-serif;overflow-x:hidden;overflow-y:auto}
.app{width:100%;min-height:100vh}
.app-header{position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:12px 20px;border-bottom:1px solid var(--line);background:var(--panel)}
.pulse-dot{width:10px;height:10px;border-radius:50%;background:var(--teal);animation:pulse 2s infinite;flex:none}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(53,217,160,.5)}70%{box-shadow:0 0 0 10px rgba(53,217,160,0)}100%{box-shadow:0 0 0 0 rgba(53,217,160,0)}}
.brand{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:19px;letter-spacing:-.02em;flex:none}
.brand span{color:var(--teal)}
.loc-indicator{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--text-dim);display:flex;align-items:center;gap:6px;white-space:nowrap;border-left:1px solid var(--line);padding-left:14px}
.loc-indicator b{color:var(--text);font-weight:500}
.spacer{flex:1}
.hdr-controls{display:flex;gap:8px;flex-wrap:wrap}
.btn{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.03em;color:var(--text-dim);background:transparent;border:1px solid var(--line);border-radius:7px;padding:8px 12px;cursor:pointer;transition:all .15s;white-space:nowrap}
.btn:hover{color:var(--text);border-color:var(--teal)}
.btn.primary{color:var(--teal);border-color:var(--teal)}
.wrap{max-width:1280px;margin:0 auto;padding:18px 20px 40px}
.gate{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px 22px;margin-bottom:18px}
.gate h2{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:600;margin-bottom:6px}
.gate p{font-size:13.5px;color:var(--text-dim);line-height:1.6;max-width:640px}
.gate .row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;align-items:center}
.gate input{font-family:'Inter',sans-serif;font-size:14px;color:var(--text);background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:10px 12px;min-width:220px;flex:1 1 220px;max-width:340px}
.gate input::placeholder{color:var(--text-faint)}
.gate input:focus{outline:none;border-color:var(--teal)}
.spinner{width:15px;height:15px;border:2px solid var(--line);border-top-color:var(--teal);border-radius:50%;display:inline-block;animation:spin .8s linear infinite;vertical-align:-2px;margin-right:8px}
@keyframes spin{to{transform:rotate(360deg)}}
.demo-flag{display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--amber);border:1px solid var(--amber);border-radius:5px;padding:2px 7px;margin-left:8px}
.gate-msg{font-size:13px;margin-top:10px;color:var(--amber)}
.privacy{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--text-faint);margin-top:14px;line-height:1.5}
.profile{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 18px;margin-bottom:18px}
.profile-head{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.profile-head .ttl{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:var(--text-faint)}
.est-flag{font-family:'IBM Plex Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--teal);border:1px solid var(--teal);border-radius:5px;padding:2px 7px}
.info-dot{width:16px;height:16px;border-radius:50%;border:1px solid var(--text-faint);color:var(--text-faint);font-size:10px;display:inline-flex;align-items:center;justify-content:center;cursor:help;position:relative}
.info-dot:hover .tip{display:block}
.tip{display:none;position:absolute;top:22px;left:0;z-index:30;width:260px;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:9px 11px;font-family:'Inter',sans-serif;font-size:11.5px;line-height:1.5;color:var(--text-dim);text-transform:none;letter-spacing:0}
.profile-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.pstat{background:var(--panel-2);border:1px solid var(--line-soft);border-radius:8px;padding:9px 11px}
.pstat .k{font-size:11px;color:var(--text-dim);white-space:nowrap}
.pstat .v{font-family:'IBM Plex Mono',monospace;font-size:16px;font-weight:600;margin-top:2px}
.main-layout{display:grid;grid-template-columns:320px minmax(0,1fr);gap:20px}
@media(max-width:900px){.main-layout{grid-template-columns:1fr}}
.panel-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px}
.col-title{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:var(--text-faint);margin-bottom:10px}
.section-label{font-family:'IBM Plex Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:.14em;padding:3px 8px;border-radius:5px;margin-bottom:8px;display:inline-block}
.section-label.green{color:var(--teal);border:1px solid rgba(53,217,160,.3);background:rgba(53,217,160,.06)}
.section-label.red{color:var(--red);border:1px solid rgba(224,82,82,.3);background:rgba(224,82,82,.06)}
.chips{display:flex;flex-direction:column;gap:6px}
@media(max-width:900px){.chips{flex-direction:row;flex-wrap:wrap}.chips .chip{flex:1 1 130px}}
.chip{display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:9px;cursor:pointer;transition:border-color .15s,transform .05s,background .15s;user-select:none;white-space:nowrap}
.chip:hover{border-color:var(--teal)}
.chip.harmful:hover{border-color:var(--red)}
.chip.armed{border-color:var(--teal);background:rgba(53,217,160,.14)}
.chip.harmful.armed{border-color:var(--red);background:rgba(224,82,82,.12)}
.chip .ico{font-size:18px;line-height:1}
.chip .lbl{font-size:12.5px;font-weight:500}
.chip .sub{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--text-faint)}
.chip .txt{display:flex;flex-direction:column;gap:1px}
.divider{height:1px;background:var(--line-soft);margin:12px 0}
.qty{margin-top:12px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:9px;padding:11px}
.qty.disabled{opacity:.4;pointer-events:none}
.qty-top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px}
.qty-label{font-size:12px;color:var(--text-dim)}
.qty-val{font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:600;color:var(--teal)}
.qty-val.harm{color:var(--red)}
.qty input[type=range]{width:100%;accent-color:var(--teal)}
.qty input[type=range].harm{accent-color:var(--red)}
.qty-hint{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--text-faint);margin-top:6px;line-height:1.5}
.deployed{margin-top:14px}
#tally{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-dim);line-height:1.8}
.board-head{display:flex;align-items:baseline;gap:12px;margin-bottom:6px;flex-wrap:wrap}
.board-title{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:15px}
.board-title small{display:block;font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-dim);font-weight:400;margin-top:2px}
.heat-readout{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--text-dim);margin-left:auto}
.heat-readout b{font-weight:600}
.heat-readout b.cool{color:var(--teal)}
.heat-readout b.warm{color:var(--coral)}
.board-note{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--text-faint);margin-bottom:10px}
#satmap{height:60vh;min-height:400px;width:100%;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--panel-2)}
#satmap.arming{cursor:crosshair}
.leaflet-container{background:#0b1416;font-family:'Inter',sans-serif}
.marker-emoji{font-size:20px;line-height:1;text-align:center;filter:drop-shadow(0 1px 2px rgba(0,0,0,.6))}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:var(--panel);color:var(--text);border:1px solid var(--line)}
.leaflet-popup-content{font-family:'IBM Plex Mono',monospace;font-size:12px;margin:9px 12px}
.leaflet-bar a{background:var(--panel);color:var(--text);border-color:var(--line)}
.leaflet-bar a:hover{background:var(--panel-2)}
.hint{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-faint);margin-top:9px}
.impact{margin-top:12px}
.impact-head{display:flex;align-items:baseline;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.impact-head .note{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-faint);margin-left:auto}
.cards{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
@media(max-width:900px){.cards{grid-template-columns:repeat(2,1fr)}}
.metric{background:var(--panel-2);border:1px solid var(--line-soft);border-radius:9px;padding:12px 14px}
.metric .m-lbl{font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.08em;white-space:nowrap}
.metric .m-val{font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:600;margin-top:4px;transition:color .3s}
.metric .m-val.pos{color:var(--teal)}
.metric .m-val.neg{color:var(--red)}
.metric .m-val.neutral{color:var(--text-dim)}
.metric .m-val small{font-size:12px;color:var(--text-dim);font-weight:400}
.metric .m-base{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--text-faint);margin-top:4px}
.bar{height:4px;border-radius:3px;margin-top:8px;background:var(--line-soft);overflow:hidden;position:relative}
.bar>.fill{position:absolute;height:100%;transition:width .4s,left .4s}
.bar>.fill.pos{background:var(--teal);left:50%}
.bar>.fill.neg{background:var(--red);right:50%}
.assumptions{margin-top:22px}
details{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:0 16px}
details summary{cursor:pointer;padding:14px 0;font-family:'IBM Plex Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:var(--text-dim);list-style:none}
details summary::-webkit-details-marker{display:none}
details summary::before{content:'▸ ';color:var(--teal)}
details[open] summary::before{content:'▾ '}
details .body{padding:0 0 16px;font-size:13px;line-height:1.7;color:var(--text-dim)}
</style>
</head>
<body>
<div class="app">
<header class="app-header">
<div class="pulse-dot"></div>
<div class="brand">Earth<span>Pulse</span> AI</div>
<div class="loc-indicator" id="locIndicator">📍 <b>Detecting…</b></div>
<div class="spacer"></div>
<div class="hdr-controls">
<button class="btn" id="btnUseLoc">Use my location</button>
<button class="btn" id="btnChangeLoc">Change location</button>
<button class="btn" id="btnRefresh">Refresh data</button>
</div>
</header>
<div class="wrap">
<section class="gate" id="gate">
<h2 id="gateTitle"><span class="spinner"></span>Detecting your location…</h2>
<p id="gateBody">EarthPulse uses your approximate location to create a local climate-resilience simulation.</p>
<div class="row" id="gateRow" style="display:none">
<input id="cityInput" type="text" placeholder="Enter city or postcode"/>
<button class="btn primary" id="btnSearchCity">Search</button>
<button class="btn" id="btnRetryLoc">Use location</button>
<button class="btn" id="btnDemo">Demo <span class="demo-flag">Singapore</span></button>
</div>
<div class="gate-msg" id="gateMsg" style="display:none"></div>
<div class="privacy">Your location is used only for this simulation and is not stored.</div>
</section>
<div id="content" style="display:none">
<section class="profile">
<div class="profile-head">
<span class="ttl">Local climate profile</span>
<span class="est-flag" id="estFlag">AI-estimated baseline</span>
<span class="info-dot">i<span class="tip">EarthPulse combines available local data with modelled estimates. Results are for planning demonstrations, not official measurements.</span></span>
</div>
<div class="profile-grid" id="profileGrid"></div>
</section>
<div class="main-layout">
<aside class="panel-card">
<div class="col-title">Actions</div>
<div class="section-label green">🌿 Green interventions</div>
<div class="chips" id="greenChips"></div>
<div class="divider"></div>
<div class="section-label red">⚠️ Harmful developments</div>
<div class="chips" id="harmChips"></div>
<div class="qty disabled" id="qtyBox">
<div class="qty-top">
<span class="qty-label" id="qtyLabel">Amount</span>
<span class="qty-val" id="qtyVal">—</span>
</div>
<input type="range" id="qtySlider" min="0" max="100" value="0"/>
<div class="qty-hint" id="qtyHint">Pick an action, choose how much, then click the map.</div>
</div>
<div class="deployed">
<div class="col-title">Deployed</div>
<div id="tally"><span style="color:var(--text-faint)">nothing yet</span></div>
</div>
</aside>
<section>
<div class="board-head">
<div class="board-title">Satellite climate twin<small id="boardPlace">—</small></div>
<div class="heat-readout">net temperature <b id="heat" class="neutral">—</b></div>
</div>
<div class="board-note">Click the map to place. Green rings = beneficial, red rings = harmful. Footprint sizes are illustrative.</div>
<div id="satmap"></div>
<div class="hint">arm an action → set amount → click the map to place it</div>
<div class="impact">
<div class="impact-head">
<span class="col-title" style="margin-bottom:0">Net impact</span>
<span class="note" id="note">—</span>
</div>
<div class="cards" id="cards"></div>
</div>
</section>
</div>
<section class="assumptions">
<details>
<summary>Model details &amp; data notice</summary>
<div class="body">
EarthPulse trains a linear model on 20 seed scenarios for green interventions, then adds explicit per-unit marginal effects for harmful developments — both scaled to the local baseline. Hotter areas amplify cooling benefits but also heat penalties; wetter areas amplify flood changes in both directions.
Outputs are net values: green shows improvement, red shows damage. Flood risk is clamped 0–100%; other metrics can swing freely positive or negative to reflect the true balance.
<div id="modelDiag" style="margin-top:10px;font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-faint)"></div>
</div>
</details>
</section>
</div>
</div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
/* ============ LEVER DEFINITIONS ============ */
const GREEN = [
  {key:'trees',icon:'🌳',label:'Trees',unit:'trees',min:5,max:500,step:5,def:50},
  {key:'greenRoofM2',icon:'🏡',label:'Green roof',unit:'m²',min:50,max:2000,step:50,def:300},
  {key:'coolRoofM2',icon:'🎨',label:'Cool roof',unit:'m²',min:50,max:2000,step:50,def:300},
  {key:'rainGardenM2',icon:'🌧️',label:'Rain garden',unit:'m²',min:50,max:1500,step:50,def:200},
  {key:'cyclingDays',icon:'🚲',label:'Cycle days',unit:'days/wk',min:1,max:5,step:1,def:2},
  {key:'solarKW',icon:'☀️',label:'Solar',unit:'kW',min:5,max:200,step:5,def:30},
  {key:'windKW',icon:'🌬️',label:'Wind',unit:'kW',min:10,max:300,step:10,def:50},
  {key:'pavedRemovedM2',icon:'🌱',label:'Un-pave',unit:'m²',min:50,max:1500,step:50,def:200},
];
const HARMFUL = [
  {key:'factory',icon:'🏭',label:'Factory',unit:'plants',min:1,max:10,step:1,def:1},
  {key:'highway',icon:'🛣️',label:'Highway',unit:'lane-km',min:1,max:20,step:1,def:2},
  {key:'parkingLot',icon:'🅿️',label:'Parking lot',unit:'×100 m²',min:1,max:30,step:1,def:3},
  {key:'towerBlock',icon:'🏗️',label:'Tower block',unit:'buildings',min:1,max:20,step:1,def:2},
  {key:'deforest',icon:'🪵',label:'Deforestation',unit:'trees cut',min:5,max:500,step:5,def:50},
  {key:'carCommute',icon:'🚗',label:'Car commute',unit:'days/wk',min:1,max:5,step:1,def:2},
  {key:'landfill',icon:'🗑️',label:'Landfill',unit:'hectares',min:1,max:20,step:1,def:2},
  {key:'fossilPlant',icon:'⛽',label:'Fossil plant',unit:'×10 MW',min:1,max:50,step:1,def:3},
];
GREEN.forEach(l=>l.harmful=false);
HARMFUL.forEach(l=>l.harmful=true);
const ALL = [...GREEN,...HARMFUL];
const FG = GREEN.map(l=>l.key), FH = HARMFUL.map(l=>l.key), FA = ALL.map(l=>l.key);
const META = Object.fromEntries(ALL.map(l=>[l.key,l]));
const ICON = Object.fromEntries(ALL.map(l=>[l.key,l.icon]));

const T = ['tempChange','aqiChange','floodRisk','carbonNet','energyNet'];
const TMETA = [
  {key:'tempChange',icon:'🌡',label:'Temperature',unitPos:'°C cooler',unitNeg:'°C warmer',max:8.5},
  {key:'aqiChange',icon:'💨',label:'Air quality',unitPos:' AQI better',unitNeg:' AQI worse',max:110},
  {key:'floodRisk',icon:'🌊',label:'Flood risk',unitPos:'%',unitNeg:'%',max:100},
  {key:'carbonNet',icon:'♻️',label:'Carbon',unitPos:' t saved',unitNeg:' t emitted',max:180},
  {key:'energyNet',icon:'⚡',label:'Energy',unitPos:' kWh saved',unitNeg:' kWh consumed',max:310000},
];

/* ============ TRAINED MODEL (green levers) ============ */
const DATA=[{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:.04,aq:0,fr:72,cs:0,es:0},{trees:150,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:.59,aq:4,fr:69,cs:3,es:100},{trees:600,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:2.38,aq:18,fr:65,cs:12,es:400},{trees:0,greenRoofM2:400,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:.31,aq:2,fr:70,cs:2,es:1500},{trees:0,greenRoofM2:1000,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:.85,aq:5,fr:65,cs:5,es:4800},{trees:0,greenRoofM2:0,coolRoofM2:500,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:.84,aq:0,fr:72,cs:1,es:3900},{trees:0,greenRoofM2:0,coolRoofM2:1400,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:2.27,aq:2,fr:72,cs:3,es:10700},{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:300,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:.18,aq:1,fr:62,cs:0,es:200},{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:900,cyclingDays:0,solarKW:0,windKW:0,pavedRemovedM2:0,td:.45,aq:7,fr:45,cs:1,es:100},{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:2,solarKW:0,windKW:0,pavedRemovedM2:0,td:.05,aq:8,fr:72,cs:15,es:0},{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:5,solarKW:0,windKW:0,pavedRemovedM2:0,td:.13,aq:23,fr:71,cs:35,es:500},{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:40,windKW:0,pavedRemovedM2:0,td:.06,aq:10,fr:71,cs:22,es:55700},{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:90,windKW:0,pavedRemovedM2:0,td:.04,aq:22,fr:72,cs:50,es:126100},{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:50,pavedRemovedM2:0,td:.03,aq:10,fr:72,cs:35,es:90100},{trees:0,greenRoofM2:0,coolRoofM2:0,rainGardenM2:0,cyclingDays:0,solarKW:0,windKW:120,pavedRemoved