  towerBlock:    {tempChange:-.15, aqiChange:-3,    floodRisk:1,    carbonNet:-6,    energyNet:-25000},
  deforest:      {tempChange:-.004,aqiChange:-.03,  floodRisk:.012, carbonNet:-.02,  energyNet:0},
  carCommute:    {tempChange:-.02, aqiChange:-4.5,  floodRisk:0,    carbonNet:-7,    energyNet:-500},
  landfill:      {tempChange:-.05, aqiChange:-8,    floodRisk:2,    carbonNet:-15,   energyNet:-1000},
